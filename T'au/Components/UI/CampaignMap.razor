@implements IAsyncDisposable
@inject IJSRuntime JS
@using Warhammer.Models.Campaign
@using Warhammer.Helpers
@using System.Globalization

<div class="map-viewport @CssClass @(AllowDrag ? "map-drag-mode" : "")">
    <div class="map-inner" @ref="_inner">
        <canvas id="campaign-topo-canvas" @ref="_canvas" class="map-layer map-canvas"></canvas>

        <svg class="map-layer map-svg" viewBox="0 0 1000 1000" preserveAspectRatio="none">
            @{
                var nodeMap = Nodes.ToDictionary(n => n.Id);
            }
            @foreach (var edge in CampaignMapHelpers.BuildEdges(Nodes))
            {
                if (nodeMap.TryGetValue(edge.From, out var n1) &&
                    nodeMap.TryGetValue(edge.To,   out var n2) &&
                    n1.X >= 0 && n2.X >= 0)
                {
                    var edgeClass = edge.Kind == CampaignMapHelpers.EdgeKind.EventAttachment
                        ? "map-edge map-edge-attachment"
                        : "map-edge";
                    <line class="@edgeClass"
                          x1="@Fmt(n1.X * 1000)" y1="@Fmt(n1.Y * 1000)"
                          x2="@Fmt(n2.X * 1000)" y2="@Fmt(n2.Y * 1000)" />
                }
            }
        </svg>

        @foreach (var node in Nodes.Where(n => n.X >= 0))
        {
            var factionCss = node is Territory territory
                ? territory.ControllingPlayerId switch
                {
                    "p1" => "node-p1",
                    "p2" => "node-p2",
                    _    => "node-neutral"
                }
                : "node-event";
            var eventCss = node is CampaignEvent ? "node-event-type" : "";
            var hidden   = !IsReadOnly && node is Territory { IsPublic: false };
            <div class="map-node @factionCss @eventCss @(hidden ? "node-hidden" : "") @(_selectedId == node.Id ? "selected" : "")"
                 data-node-id="@node.Id"
                 style="left:@(Fmt(node.X * 100))%;top:@(Fmt(node.Y * 100))%"
                 @onclick="@(() => HandleNodeClick(node.Id))"
                 @onclick:stopPropagation="true">
                <div class="map-node-pip"></div>
                <span class="map-node-label">@(hidden ? $"\U0001f512 {node.Name}" : node.Name)</span>
            </div>
        }

        @foreach (var note in MapNotes.Where(n => n.X >= 0))
        {
            var noteLabel = (!IsReadOnly && !note.IsPublic) ? $"\U0001f512 {note.Title}" : note.Title;
            var noteCss   = (!IsReadOnly && !note.IsPublic) ? "note-private" : "note-public";
            <div class="map-node map-note-pin @noteCss @(_selectedId == note.Id ? "selected" : "")"
                 data-node-id="@note.Id"
                 style="left:@(Fmt(note.X * 100))%;top:@(Fmt(note.Y * 100))%"
                 @onclick="@(() => HandleNodeClick(note.Id))"
                 @onclick:stopPropagation="true">
                <div class="map-note-icon">&#x1F4CC;</div>
                <span class="map-node-label">@noteLabel</span>
            </div>
        }
    </div>
</div>

<style>
    .map-viewport {
        position: relative;
        width: 100%;
        aspect-ratio: 16 / 9;
        min-height: 320px;
        overflow: hidden;
        background: #06080e;
        border: 1px solid #2a2a2a;
        border-radius: 6px;
        user-select: none;
    }
    .map-inner {
        position: absolute;
        top: 0;
        left: 0;
        width: 200%;
        height: 200%;
    }
    .map-layer {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
    }
    .map-canvas { pointer-events: none; }
    .map-svg    { pointer-events: none; overflow: visible; }

    .map-edge {
        stroke: #c8960c;
        stroke-width: 2.5;
        stroke-dasharray: 6 4;
        opacity: 0.7;
    }
    /* Event-attachment links: solid violet line, thinner, no dashes */
    .map-edge-attachment {
        stroke: #bd93f9;
        stroke-width: 1.5;
        stroke-dasharray: none;
        opacity: 0.85;
    }

    .map-node {
        position: absolute;
        transform: translate(-50%, -50%);
        cursor: pointer;
        z-index: 10;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 3px;
    }
    .map-drag-mode .map-node          { cursor: grab; }
    .map-drag-mode .map-node.dragging { cursor: grabbing; }
    .map-drag-mode.map-dragging       { cursor: grabbing !important; }

    .map-node-pip {
        width: 14px;
        height: 14px;
        transform: rotate(45deg);
        border: 2px solid currentColor;
        background: rgba(0, 0, 0, 0.65);
        transition: box-shadow 0.2s;
    }
    /* Campaign events use a circle pip instead of a diamond */
    .node-event-type .map-node-pip {
        border-radius: 50%;
        transform: none;
    }
    .map-node:hover .map-node-pip,
    .map-node.selected .map-node-pip {
        box-shadow: 0 0 8px currentColor, 0 0 18px currentColor;
    }
    .map-node-label {
        font-size: 10px;
        font-family: 'Courier New', monospace;
        font-weight: bold;
        letter-spacing: 0.5px;
        text-shadow: 0 0 8px currentColor;
        white-space: nowrap;
        background: rgba(0, 0, 0, 0.6);
        padding: 1px 5px;
        border-radius: 2px;
    }
    .node-p1      { color: #4da6ff; }
    .node-p2      { color: #ff5555; }
    .node-neutral { color: #c8960c; }
    .node-event   { color: #bd93f9; }
    .node-hidden  { opacity: 0.55; }

    .map-note-pin  { z-index: 11; }
    .map-note-icon { font-size: 16px; line-height: 1; }
    .note-public   { color: #50fa7b; }
    .note-private  { color: #bd93f9; opacity: 0.8; }
</style>

@code {
    [Parameter, EditorRequired] public List<Node> Nodes { get; set; } = new();
    [Parameter] public List<GmNote> MapNotes  { get; set; } = new();
    [Parameter] public bool          IsReadOnly { get; set; }
    [Parameter] public EventCallback<string>                          OnNodeSelected { get; set; }
    [Parameter] public EventCallback<(string Id, double X, double Y)> NodeMoved     { get; set; }
    [Parameter, EditorRequired] public WorldSurfaceSettings Surface { get; set; } = default!;
    [Parameter] public bool   AllowDrag { get; set; }
    [Parameter] public bool   AllowPan  { get; set; }
    [Parameter] public string CssClass  { get; set; } = "";

    private ElementReference _canvas;
    private ElementReference _inner;
    private DotNetObjectReference<CampaignMap>? _dotNetRef;
    private string? _selectedId;
    private WorldSurfaceSettings? _lastDrawn;
    private bool _didDrag;

    private static string Fmt(double v) =>
        v.ToString("F2", CultureInfo.InvariantCulture);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!Surface.Equals(_lastDrawn))
        {
            _lastDrawn = Surface;
            await JS.InvokeVoidAsync("topoMapInterop.drawById", "campaign-topo-canvas", Surface);
        }

        if (firstRender)
        {
            if (AllowDrag)
            {
                _dotNetRef = DotNetObjectReference.Create(this);
                await JS.InvokeVoidAsync("mapNodeInterop.initEditor", _inner, _dotNetRef);
            }
            if (AllowPan)
                await JS.InvokeVoidAsync("mapNodeInterop.initWarRoom", _inner);
        }
    }

    public async Task<(double X, double Y)> GetViewCenterAsync()
    {
        try
        {
            var result = await JS.InvokeAsync<System.Text.Json.JsonElement>(
                "mapNodeInterop.getViewCenter", _inner);
            return (result.GetProperty("x").GetDouble(), result.GetProperty("y").GetDouble());
        }
        catch
        {
            return (0.5, 0.5);
        }
    }

    private async Task HandleNodeClick(string id)
    {
        if (_didDrag) { _didDrag = false; return; }
        _selectedId = id;
        StateHasChanged();
        await OnNodeSelected.InvokeAsync(id);
    }

    [JSInvokable]
    public async Task OnNodeMoved(string id, double x, double y)
    {
        _didDrag = true;
        var node = Nodes.FirstOrDefault(n => n.Id == id);
        if (node is not null)
        {
            node.X = Math.Round(x, 4);
            node.Y = Math.Round(y, 4);
        }
        else
        {
            var note = MapNotes.FirstOrDefault(n => n.Id == id);
            if (note is null) return;
            note.X = Math.Round(x, 4);
            note.Y = Math.Round(y, 4);
        }
        await NodeMoved.InvokeAsync((id, x, y));
    }

    public async ValueTask DisposeAsync()
    {
        try { await JS.InvokeVoidAsync("mapNodeInterop.destroy", _inner); }
        catch { /* tearing down */ }
        _dotNetRef?.Dispose();
    }
}
