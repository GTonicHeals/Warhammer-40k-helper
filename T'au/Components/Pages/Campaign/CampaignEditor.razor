@page "/campaign-editor"
@rendermode InteractiveServer
@using Warhammer.Models.Campaign
@using Warhammer.Services

@inject CampaignManagerService CampaignSvc

<UnsavedChangesGuard IsDirty="_hasUnsavedChanges" OnSaveAndLeave="SaveAsync" />

<PageTitle>Campaign Map Editor</PageTitle>

<div class="rules-container">
    <div class="header-section text-center mb-4">
        <h1 class="page-title text-warning">
            <i class="bi bi-map me-2"></i>Campaign Map Editor
        </h1>
        <p class="text-muted">Build the strategic map — place nodes on the terrain, assign control, and link them.</p>
    </div>

    @if (!_loaded)
    {
        <p class="text-center text-muted"><em>Loading campaign…</em></p>
    }
    else if (_campaign is null)
    {
        <div class="alert alert-warning">Failed to load campaign data.</div>
    }
    else
    {
        <div class="d-flex align-items-center justify-content-between mb-3 gap-3">
            <input class="form-control form-control-lg campaign-title-input"
                   @bind="_campaign.CampaignName"
                   @bind:after="MarkDirty"
                   placeholder="Campaign Name" />
            <button class="btn btn-outline-secondary flex-shrink-0" @onclick="() => _showGmNotes = true"
                    title="GM Notes &amp; Lore">
                <i class="bi bi-journal-text me-1"></i> GM Notes
            </button>
            <button class="btn btn-outline-secondary flex-shrink-0" id="req-open" @onclick="() => _showRequisitions = !_showRequisitions"
                    title="What Requisition Points can buy">
                <i class="bi bi-box-seam me-1"></i> Requisitions
            </button>
            @if (_showSavedToast)
            {
                <span class="ce-save-toast flex-shrink-0" role="status" aria-live="polite">
                    <i class="bi bi-check-circle-fill me-1"></i>Saved
                </span>
            }
            <button class="btn btn-warning px-4 flex-shrink-0" id="campaign-save" @onclick="SaveAsync" disabled="@_saving">
                @if (_saving)
                {
                    <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                }
                <i class="bi bi-floppy me-1"></i> Save
            </button>
        </div>

        @if (_showGmNotes)
        {
            <GmNotes Campaign="_campaign"
                     SelectedNoteId="_gmNotesNoteId"
                     OnNotesChanged="HandleGmNotesChanged"
                     OnClose="() => { _showGmNotes = false; _gmNotesNoteId = null; }" />
        }

        @if (_showRequisitions)
        {
            <RequisitionEditor Campaign="_campaign" OnChanged="MarkRequisitionsDirty" OnClose="() => _showRequisitions = false" />
        }

        <div class="row g-4">
            <!-- Left: Map -->
            <div class="col-lg-7">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <select class="form-select form-select-sm bg-dark text-warning border-secondary ce-biome-select"
                            value="@_campaign.MapBiome"
                            @onchange="OnBiomeChanged">
                        <option value="agri">Agri World</option>
                        <option value="death">Death World</option>
                        <option value="ice">Ice World</option>
                        <option value="ash">Ash Wastes</option>
                    </select>
                    <button class="btn btn-sm btn-outline-warning flex-shrink-0" @onclick="RegenerateMap">
                        <i class="bi bi-arrow-repeat me-1"></i>Regenerate
                    </button>
                    <a class="btn btn-sm btn-outline-secondary flex-shrink-0" href="/map-generator">
                        <i class="bi bi-sliders me-1"></i>Tune Map
                    </a>
                    <button class="btn btn-sm btn-outline-info flex-shrink-0" @onclick="AddMapNoteAsync">
                        <i class="bi bi-pin-map me-1"></i>Add Note
                    </button>
                    <span class="text-muted small flex-shrink-0">Seed: @_campaign.MapSeed</span>
                </div>
                <CampaignMap @ref="_mapComponent"
                             Nodes="_campaign.MapNodes"
                             MapNotes="_campaign.GmNotebook.Where(n => n.X >= 0).ToList()"
                             MapSeed="_campaign.MapSeed" MapBiome="@_campaign.MapBiome"
                             MapOctaves="_campaign.MapOctaves" MapLacunarity="_campaign.MapLacunarity"
                             MapPersistence="_campaign.MapPersistence" MapScale="_campaign.MapScale"
                             MapOffsetX="_campaign.MapOffsetX" MapOffsetY="_campaign.MapOffsetY"
                             AllowDrag="true"
                             NodeMoved="HandleNodeMoved"
                             OnNodeSelected="HandleNodeSelected" />
                <p class="text-muted small mt-1 mb-0"><i class="bi bi-arrows-move me-1"></i>Drag nodes to position them on the map.</p>
            </div>

            <!-- Right: Add node form + selected node editor -->
            <div class="col-lg-5">

                <!-- Add node form -->
                <div class="ce-form-panel mb-3">
                    <h5 class="text-warning mb-3"><i class="bi bi-plus-circle me-2"></i>Add Node</h5>

                    <!-- Node type selector -->
                    <div class="mb-3">
                        <label class="form-label text-warning fw-bold small mb-1">Node Type</label>
                        <TilePicker TValue="bool"
                                    Options="_nodeTypeOptions"
                                    Selected="_newNodeIsEvent"
                                    SelectedChanged="@(v => _newNodeIsEvent = v)"
                                    CssClass="ce-type-grid"
                                    TileClass="ce-type-tile"
                                    OnClass="ce-type-tile-on" />
                    </div>

                    <div class="mb-2">
                        <label class="form-label text-warning fw-bold small mb-1">Node Name</label>
                        <input class="form-control form-control-sm bg-dark text-white border-secondary"
                               @bind="_newNodeName" placeholder="@(_newNodeIsEvent ? "e.g. The Ambush at Krugg's Crossing" : "e.g. Sector Alpha")" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label text-warning fw-bold small mb-1">Description</label>
                        <input class="form-control form-control-sm bg-dark text-white border-secondary"
                               @bind="_newNodeDescription" placeholder="@(_newNodeIsEvent ? "e.g. A skirmish erupts in the ruins" : "e.g. Ruined manufactorum district")" />
                    </div>

                    @if (!_newNodeIsEvent)
                    {
                        <div class="mb-2">
                            <label class="form-label text-warning fw-bold small mb-1">Buff Effect</label>
                            <input class="form-control form-control-sm bg-dark text-white border-secondary"
                                   @bind="_newNodeBuffEffect" placeholder="e.g. +1 CP per round" />
                        </div>
                        <div class="mb-2">
                            <label class="form-label text-warning fw-bold small mb-1">Victory Point Value</label>
                            <input type="number" min="0" class="form-control form-control-sm bg-dark text-white border-secondary"
                                   @bind="_newNodeVictoryPointValue" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label text-warning fw-bold small mb-1">Terrain Type</label>
                            <TilePicker TValue="TerrainType"
                                        Options="_terrainOptions"
                                        Selected="_newNodeTerrainType"
                                        SelectedChanged="@(v => _newNodeTerrainType = v)"
                                        CssClass="terrain-grid"
                                        TileClass="terrain-tile"
                                        OnClass="terrain-tile-on" />
                        </div>
                    }
                    else
                    {
                        <div class="mb-2">
                            <label class="form-label text-warning fw-bold small mb-1">
                                <i class="bi bi-eye-slash me-1"></i>Secret Event Text (Hidden from Players)
                            </label>
                            <textarea class="form-control form-control-sm bg-dark text-white border-secondary"
                                      rows="3"
                                      @bind="_newNodeSecretEventText"
                                      placeholder="Write the hidden event text here…"></textarea>
                        </div>
                        <div class="mb-2 d-flex align-items-center gap-2">
                            <input type="checkbox" class="form-check-input" id="chk-new-revealed"
                                   @bind="_newNodeIsEventRevealed" />
                            <label class="form-check-label small text-muted" for="chk-new-revealed">
                                Mark event as already revealed (visible to players)
                            </label>
                        </div>
                        <div class="mb-3">
                            <label class="form-label text-warning fw-bold small mb-1">Attached to Territory</label>
                            <TilePicker TValue="string"
                                        Options="BuildAttachmentOptions()"
                                        Selected="_newNodeAttachedToNodeId!"
                                        SelectedChanged="@(v => _newNodeAttachedToNodeId = v)"
                                        CssClass="ce-attachment-grid"
                                        TileClass="ce-attachment-tile"
                                        OnClass="ce-attachment-tile-on" />
                        </div>
                    }

                    <button class="btn btn-sm btn-warning w-100" @onclick="AddNodeAsync"
                            disabled="@(!CanAddNewNode)">
                        <i class="bi bi-plus-lg"></i> Add @(_newNodeIsEvent ? "Event" : "Territory")
                    </button>
                </div>

                <!-- Selected node editor -->
                @if (_selectedNode is not null)
                {
                    var otherNodes = _campaign.MapNodes.Where(n => n.Id != _selectedNode.Id).ToList();

                    @if (_selectedNode is Territory territory)
                    {
                        var ctrl = territory.ControllingPlayerId;
                        var (badgeClass, badgeLabel) = ctrl switch
                        {
                            "p1" => ("badge-p1", _campaign.Players.FirstOrDefault(p => p.Id == "p1")?.Name ?? "Player 1"),
                            "p2" => ("badge-p2", _campaign.Players.FirstOrDefault(p => p.Id == "p2")?.Name ?? "Player 2"),
                            _    => ("badge-neutral", "Neutral")
                        };

                        <div class="ce-editor-card">
                            <div class="ce-editor-header">
                                <div class="ce-editor-title">
                                    <i class="bi bi-geo-alt-fill"></i>
                                    <input class="ce-editor-title-input"
                                           @bind="_selectedNode.Name"
                                           @bind:after="MarkDirty"
                                           placeholder="Unnamed Territory" />
                                </div>
                                <div class="ce-editor-meta">
                                    <span class="ce-badge @badgeClass">@badgeLabel</span>
                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => RemoveNode(_selectedNode.Id)">
                                        <i class="bi bi-trash me-1"></i>Delete
                                    </button>
                                </div>
                            </div>
                            <div class="ce-editor-body">
                                <div class="mb-2">
                                    <label class="form-label small text-warning mb-1">Description</label>
                                    <input class="form-control form-control-sm bg-dark text-white border-secondary"
                                           @bind="_selectedNode.Description"
                                           @bind:after="MarkDirty"
                                           placeholder="—" />
                                </div>
                                <div class="mb-2">
                                    <label class="form-label small text-warning mb-1">Buff Effect</label>
                                    <input class="form-control form-control-sm bg-dark text-white border-secondary"
                                           @bind="territory.BuffEffect"
                                           @bind:after="MarkDirty"
                                           placeholder="—" />
                                </div>
                                <div class="mb-2">
                                    <label class="form-label small text-warning mb-1">Victory Point Value</label>
                                    <input type="number" min="0" class="form-control form-control-sm bg-dark text-white border-secondary"
                                           @bind="territory.VictoryPointValue"
                                           @bind:after="MarkDirty" />
                                </div>

                                <div class="mb-2">
                                    <label class="form-label small text-warning mb-1">Terrain Type</label>
                                    <TilePicker TValue="TerrainType"
                                                Options="_terrainOptions"
                                                Selected="territory.TerrainType"
                                                SelectedChanged="@(v => { territory.TerrainType = v; MarkDirty(); })"
                                                CssClass="terrain-grid"
                                                TileClass="terrain-tile"
                                                OnClass="terrain-tile-on" />
                                </div>

                                <div class="mb-2">
                                    <label class="form-label small text-warning mb-1">Controller</label>
                                    <select class="form-select form-select-sm bg-dark text-white border-secondary"
                                            value="@(territory.ControllingPlayerId ?? "")"
                                            @onchange="e => SetController(territory, e.Value?.ToString())">
                                        <option value="">— Neutral —</option>
                                        @foreach (var player in _campaign.Players)
                                        {
                                            <option value="@player.Id">@player.Name (@player.Id.ToUpper())</option>
                                        }
                                    </select>
                                </div>

                                @if (otherNodes.Any())
                                {
                                    <label class="form-label small text-warning mb-1">Connections</label>
                                    <div class="ce-connections-list mb-2">
                                        @foreach (var other in otherNodes)
                                        {
                                            var linked = _selectedNode.ConnectedNodeIds.Contains(other.Id);
                                            <label class="ce-connection-item @(linked ? "linked" : "")">
                                                <input type="checkbox" checked="@linked"
                                                       @onchange="() => ToggleConnection(_selectedNode, other.Id)" />
                                                <span>@(string.IsNullOrWhiteSpace(other.Name) ? "Unnamed" : other.Name)</span>
                                            </label>
                                        }
                                    </div>
                                }

                            </div>
                        </div>
                    }
                    else if (_selectedNode is CampaignEvent evt)
                    {
                        <div class="ce-editor-card">
                            <div class="ce-editor-header">
                                <div class="ce-editor-title">
                                    <i class="bi bi-calendar-event-fill"></i>
                                    <input class="ce-editor-title-input"
                                           @bind="_selectedNode.Name"
                                           @bind:after="MarkDirty"
                                           placeholder="Unnamed Event" />
                                </div>
                                <div class="ce-editor-meta">
                                    <span class="ce-badge badge-event">EVENT</span>
                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => RemoveNode(_selectedNode.Id)">
                                        <i class="bi bi-trash me-1"></i>Delete
                                    </button>
                                </div>
                            </div>
                            <div class="ce-editor-body">
                                <div class="mb-2">
                                    <label class="form-label small text-warning mb-1">Description</label>
                                    <input class="form-control form-control-sm bg-dark text-white border-secondary"
                                           @bind="_selectedNode.Description"
                                           @bind:after="MarkDirty"
                                           placeholder="—" />
                                </div>
                                <div class="mb-2">
                                    <label class="form-label small text-warning mb-1">
                                        <i class="bi bi-eye-slash me-1"></i>Secret Event Text (Hidden from Players)
                                    </label>
                                    <textarea class="form-control form-control-sm bg-dark text-white border-secondary"
                                              rows="3"
                                              @bind="evt.SecretEventText"
                                              @bind:after="MarkDirty"
                                              placeholder="Write the hidden event text here…"></textarea>
                                </div>
                                <div class="mb-2 d-flex align-items-center gap-2">
                                    <input type="checkbox" class="form-check-input" id="chk-revealed"
                                           @bind="evt.IsEventRevealed"
                                           @bind:after="MarkDirty" />
                                    <label class="form-check-label small text-muted" for="chk-revealed">
                                        Mark event as already revealed (visible to players)
                                    </label>
                                </div>
                                <div class="mb-2">
                                    <label class="form-label small text-warning mb-1">Attached to Territory</label>
                                    <TilePicker TValue="string"
                                                Options="BuildAttachmentOptions()"
                                                Selected="evt.AttachedToNodeId!"
                                                SelectedChanged="@(v => { evt.AttachedToNodeId = v; MarkDirty(); })"
                                                CssClass="ce-attachment-grid"
                                                TileClass="ce-attachment-tile"
                                                OnClass="ce-attachment-tile-on" />
                                </div>

                            </div>
                        </div>
                    }
                }
                else if (_selectedMapNote is not null)
                {
                    <div class="ce-editor-card">
                        <div class="ce-editor-header">
                            <div class="ce-editor-title">
                                <i class="bi bi-pin-map-fill"></i>
                                <input class="ce-editor-title-input"
                                       @bind="_selectedMapNote.Title"
                                       @bind:after="MarkDirty"
                                       placeholder="Unnamed Note" />
                            </div>
                            <div class="ce-editor-meta">
                                <span class="ce-badge @(_selectedMapNote.IsPublic ? "badge-p1" : "badge-neutral")">
                                    @(_selectedMapNote.IsPublic ? "PUBLIC" : "PRIVATE")
                                </span>
                                <button class="btn btn-sm btn-outline-danger" @onclick="RemoveSelectedMapNote">
                                    <i class="bi bi-trash me-1"></i>Delete
                                </button>
                            </div>
                        </div>
                        <div class="ce-editor-body">
                            <div class="mb-2">
                                <label class="form-label small text-warning mb-1">Tags</label>
                                <input class="form-control form-control-sm bg-dark text-white border-secondary"
                                       placeholder="e.g. lore, objective"
                                       @bind="_selectedMapNote.Tags"
                                       @bind:after="MarkDirty" />
                            </div>
                            <div class="mb-2">
                                <label class="form-label small text-warning mb-1">Content</label>
                                <textarea class="form-control form-control-sm bg-dark text-white border-secondary"
                                          rows="5"
                                          @bind="_selectedMapNote.Content"
                                          @bind:after="MarkDirty"
                                          placeholder="Note content…"></textarea>
                            </div>
                            <div class="form-check form-check-inline mb-0 mt-2">
                                <input type="checkbox" class="form-check-input" id="chk-note-pub"
                                       @bind="_selectedMapNote.IsPublic"
                                       @bind:after="MarkDirty" />
                                <label class="form-check-label small text-muted" for="chk-note-pub">
                                    Visible to players
                                </label>
                            </div>
                        </div>
                    </div>
                }
                else if (_campaign.MapNodes.Any() || _campaign.GmNotebook.Any(n => n.X >= 0))
                {
                    <p class="text-muted text-center small mt-3"><em>Click a node or note pin on the map to edit it.</em></p>
                }
            </div>
        </div>
    }
</div>

@code {
    private Campaign? _campaign;
    private CampaignMap? _mapComponent;
    private bool _loaded;
    private bool _saving;
    private bool _hasUnsavedChanges;
    private bool _showSavedToast;
    private int  _saveToastToken;
    private bool _showGmNotes;
    private bool _showRequisitions;
    private string? _gmNotesNoteId;
    private Node?   _selectedNode;
    private GmNote? _selectedMapNote;

    private bool       _newNodeIsEvent          = false;
    private string     _newNodeName             = "";
    private string     _newNodeDescription      = "";
    // Territory-specific
    private string     _newNodeBuffEffect        = "";
    private int        _newNodeVictoryPointValue = 1;
    private TerrainType _newNodeTerrainType      = TerrainType.Standard;
    // CampaignEvent-specific
    private string     _newNodeSecretEventText   = "";
    private bool       _newNodeIsEventRevealed   = false;
    private string?    _newNodeAttachedToNodeId  = null;

    private bool CanAddNewNode =>
        !string.IsNullOrWhiteSpace(_newNodeName)
        && (!_newNodeIsEvent || !string.IsNullOrWhiteSpace(_newNodeAttachedToNodeId));

    private static readonly IReadOnlyList<TilePickerOption<bool>> _nodeTypeOptions = new[]
    {
        new TilePickerOption<bool>(false, "Territory",      "bi-geo-alt-fill"),
        new TilePickerOption<bool>(true,  "Campaign Event", "bi-calendar-event-fill"),
    };

    private static readonly IReadOnlyList<TilePickerOption<TerrainType>> _terrainOptions =
        Enum.GetValues<TerrainType>()
            .Select(t => new TilePickerOption<TerrainType>(t, TerrainHelpers.Label(t), TerrainHelpers.Icon(t)))
            .ToList();

    private IReadOnlyList<TilePickerOption<string>> BuildAttachmentOptions()
    {
        var list = new List<TilePickerOption<string>>
        {
            new(null!, "— None —", "bi-slash-circle")
        };
        if (_campaign is not null)
        {
            list.AddRange(_campaign.MapNodes.OfType<Territory>().Select(t =>
                new TilePickerOption<string>(
                    t.Id,
                    string.IsNullOrWhiteSpace(t.Name) ? "Unnamed" : t.Name,
                    TerrainHelpers.Icon(t.TerrainType))));
        }
        return list;
    }

    private void MarkDirty() => _hasUnsavedChanges = true;

    // Requisition edits are only written by the Save button; the GM Notes autosave leaves them out.
    private bool _requisitionsDirty;

    private void MarkRequisitionsDirty()
    {
        _requisitionsDirty = true;
        MarkDirty();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _loaded) return;
        _loaded   = true;
        _campaign = await CampaignSvc.LoadCampaignAsync();

        // Auto-place legacy nodes that have no coordinates yet
        int idx = 0;
        bool anyPlaced = false;
        foreach (var node in _campaign.MapNodes.Where(n => n.X < 0))
        {
            node.X = 0.05;
            node.Y = Math.Min(0.90, 0.10 + idx * 0.12);
            idx++;
            anyPlaced = true;
        }
        if (anyPlaced)
            await CampaignSvc.SaveCampaignAsync(_campaign);

        StateHasChanged();
    }

    private void HandleNodeSelected(string nodeId)
    {
        _selectedNode    = _campaign?.MapNodes.FirstOrDefault(n => n.Id == nodeId);
        _selectedMapNote = _selectedNode is null
            ? _campaign?.GmNotebook.FirstOrDefault(n => n.Id == nodeId && n.X >= 0)
            : null;
        StateHasChanged();
    }

    private void HandleNodeMoved((string Id, double X, double Y) args)
    {
        if (_campaign is null) return;
        MarkDirty();
    }

    private void RegenerateMap()
    {
        if (_campaign is null) return;
        _campaign.MapSeed = Random.Shared.Next(1, 999_999);
        MarkDirty();
    }

    private void OnBiomeChanged(ChangeEventArgs e)
    {
        if (_campaign is null) return;
        _campaign.MapBiome = e.Value?.ToString() ?? "agri";
        MarkDirty();
    }

    private async Task AddNodeAsync()
    {
        if (_campaign is null || string.IsNullOrWhiteSpace(_newNodeName)) return;
        if (_newNodeIsEvent && string.IsNullOrWhiteSpace(_newNodeAttachedToNodeId)) return;

        var (cx, cy) = _mapComponent is not null
            ? await _mapComponent.GetViewCenterAsync()
            : (0.5, 0.5);

        if (_newNodeIsEvent)
        {
            _campaign.MapNodes.Add(new CampaignEvent
            {
                Name             = _newNodeName.Trim(),
                Description      = _newNodeDescription.Trim(),
                SecretEventText  = _newNodeSecretEventText.Trim(),
                IsEventRevealed  = _newNodeIsEventRevealed,
                AttachedToNodeId = _newNodeAttachedToNodeId,
                X                = cx,
                Y                = cy
            });
            _newNodeSecretEventText  = "";
            _newNodeIsEventRevealed  = false;
            _newNodeAttachedToNodeId = null;
        }
        else
        {
            _campaign.MapNodes.Add(new Territory
            {
                Name               = _newNodeName.Trim(),
                Description        = _newNodeDescription.Trim(),
                BuffEffect         = _newNodeBuffEffect.Trim(),
                VictoryPointValue  = _newNodeVictoryPointValue,
                TerrainType        = _newNodeTerrainType,
                X                  = cx,
                Y                  = cy
            });
            _newNodeBuffEffect        = "";
            _newNodeVictoryPointValue = 1;
            _newNodeTerrainType       = TerrainType.Standard;
        }

        _newNodeName        = "";
        _newNodeDescription = "";
        MarkDirty();
    }

    private void RemoveNode(string nodeId)
    {
        if (_campaign is null) return;
        _campaign.MapNodes.RemoveAll(n => n.Id == nodeId);
        foreach (var node in _campaign.MapNodes)
            node.ConnectedNodeIds.Remove(nodeId);

        if (_selectedNode?.Id == nodeId)
            _selectedNode = null;
        MarkDirty();
    }

    private async Task AddMapNoteAsync()
    {
        if (_campaign is null) return;
        var (cx, cy) = _mapComponent is not null
            ? await _mapComponent.GetViewCenterAsync()
            : (0.5, 0.5);
        var note = new GmNote { X = cx, Y = cy };
        _campaign.GmNotebook.Insert(0, note);
        _selectedNode    = null;
        _selectedMapNote = note;
        MarkDirty();
    }

    private void RemoveSelectedMapNote()
    {
        if (_campaign is null || _selectedMapNote is null) return;
        _campaign.GmNotebook.Remove(_selectedMapNote);
        _selectedMapNote = null;
        MarkDirty();
    }

    private void SetController(Territory territory, string? value)
    {
        territory.ControllingPlayerId = string.IsNullOrEmpty(value) ? null : value;
        MarkDirty();
    }

    private void ToggleConnection(Node node, string targetId)
    {
        if (_campaign is null) return;
        var target = _campaign.MapNodes.FirstOrDefault(n => n.Id == targetId);
        if (target is null) return;

        if (node.ConnectedNodeIds.Contains(targetId))
        {
            node.ConnectedNodeIds.Remove(targetId);
            target.ConnectedNodeIds.Remove(node.Id);
        }
        else
        {
            node.ConnectedNodeIds.Add(targetId);
            if (!target.ConnectedNodeIds.Contains(node.Id))
                target.ConnectedNodeIds.Add(node.Id);
        }
        MarkDirty();
    }

    private async Task SaveAsync()
    {
        if (_campaign is null) return;
        _saving = true;
        StateHasChanged();
        await CampaignSvc.SaveCampaignAsync(_campaign, saveRequisitions: true);
        _saving = false;
        _hasUnsavedChanges = false;
        _requisitionsDirty = false;

        var token = ++_saveToastToken;
        _showSavedToast = true;
        StateHasChanged();
        await Task.Delay(2000);
        if (token == _saveToastToken)
        {
            _showSavedToast = false;
            StateHasChanged();
        }
    }

    private async Task HandleGmNotesChanged()
    {
        if (_campaign is null) return;
        await CampaignSvc.SaveCampaignAsync(_campaign);
        // Unconfirmed Requisition edits are still waiting for the Save button.
        _hasUnsavedChanges = _requisitionsDirty;
    }
}
