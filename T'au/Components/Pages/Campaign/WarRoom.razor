@page "/war-room"
@rendermode InteractiveServer
@using Warhammer.Models.Campaign
@using Warhammer.Services
@inject CampaignManagerService CampaignSvc

<PageTitle>War Room</PageTitle>

@if (!_loaded)
{
    <div class="wr-loading">
        <span class="wr-blink">[ LOADING TACTICAL FEED… ]</span>
    </div>
}
else if (_campaign is null)
{
    <div class="wr-loading">
        <span class="text-danger">[ UPLINK FAILURE — CAMPAIGN DATA UNAVAILABLE ]</span>
    </div>
}
else
{
    <div class="wr-root">

        <!-- HUD header — full width -->
        <div class="wr-hud-bar">
            <div class="wr-hud-left">
                <i class="bi bi-broadcast-pin me-2"></i>
                <span class="wr-hud-title">TACTICAL COMMAND</span>
                <span class="wr-hud-sep">//</span>
                <span class="wr-campaign-name">@(_campaign.CampaignName is { Length: > 0 } n ? n.ToUpperInvariant() : "UNNAMED CAMPAIGN")</span>
            </div>
            <div class="wr-hud-right">
                @if (_p1 is not null)
                {
                    <span class="wr-terr-pill wr-pill-p1">
                        <i class="bi bi-flag-fill me-1"></i>@_p1.Name.ToUpperInvariant() <strong>@_p1Terr</strong>
                    </span>
                }
                <span class="wr-terr-pill wr-pill-neutral">NEUTRAL <strong>@_neuTerr</strong></span>
                @if (_p2 is not null)
                {
                    <span class="wr-terr-pill wr-pill-p2">
                        <i class="bi bi-flag-fill me-1"></i>@_p2.Name.ToUpperInvariant() <strong>@_p2Terr</strong>
                    </span>
                }
            </div>
        </div>

        <!-- Territory control strip — full width -->
        @if (_totalTerr > 0)
        {
            <div class="wr-control-strip">
                @if (_p1Terr > 0)   { <div class="wr-strip-p1"      style="width:@(_p1Terr  * 100.0 / _totalTerr)%"></div> }
                @if (_neuTerr > 0)  { <div class="wr-strip-neutral"  style="width:@(_neuTerr * 100.0 / _totalTerr)%"></div> }
                @if (_p2Terr > 0)   { <div class="wr-strip-p2"       style="width:@(_p2Terr  * 100.0 / _totalTerr)%"></div> }
            </div>
        }

        <!-- Main content: map (left) + info panel (right) -->
        <div class="wr-content">

            <!-- Map -->
            <div class="wr-map-col">
                <div class="wr-map-shell">
                    <div class="wr-scanlines"></div>
                    @if (_campaign.MapNodes.Any())
                    {
                        <CampaignMap Nodes="_campaign.MapNodes"
                                     MapNotes="_campaign.GmNotebook.Where(n => n.X >= 0 && n.IsPublic).ToList()"
                                     IsReadOnly="true"
                                     MapSeed="_campaign.MapSeed" MapBiome="@_campaign.MapBiome"
                                     MapOctaves="_campaign.MapOctaves" MapLacunarity="_campaign.MapLacunarity"
                                     MapPersistence="_campaign.MapPersistence" MapScale="_campaign.MapScale"
                                     MapOffsetX="_campaign.MapOffsetX" MapOffsetY="_campaign.MapOffsetY"
                                     AllowPan="true"
                                     OnNodeSelected="HandleNodeSelected" />
                    }
                    else
                    {
                        <div class="wr-no-nodes">
                            <i class="bi bi-exclamation-diamond me-2"></i>
                            NO TERRITORIES —
                            <a href="campaign-editor" class="text-warning ms-1">OPEN EDITOR</a>
                        </div>
                    }
                </div>
            </div>

            <!-- Info side panel -->
            <div class="wr-side-col">

                <!-- Sector intel -->
                <div class="wr-panel">
                    <div class="wr-panel-head"><i class="bi bi-crosshair me-2"></i>SECTOR INTEL</div>
                    <div class="wr-panel-body">
                        @if (_selectedMapNote is not null)
                        {
                            <div class="wr-intel-name">&#x1F4CC; @_selectedMapNote.Title.ToUpperInvariant()</div>
                            @if (!string.IsNullOrWhiteSpace(_selectedMapNote.Content))
                            {
                                <div class="wr-secret-event mt-2">
                                    <div class="wr-secret-body">@_selectedMapNote.Content</div>
                                </div>
                            }
                        }
                        else if (_selectedNode is not null)
                        {
                            var ctrlClass = _selectedNode.ControllingPlayerId switch
                            {
                                "p1" => "wr-text-p1",
                                "p2" => "wr-text-p2",
                                _    => "wr-text-neutral"
                            };
                            var ctrlName = _selectedNode.ControllingPlayerId switch
                            {
                                "p1" => _p1?.Name ?? "Player 1",
                                "p2" => _p2?.Name ?? "Player 2",
                                _    => "Neutral"
                            };
                            var links = _selectedNode.ConnectedNodeIds
                                .Select(id => _campaign!.MapNodes.FirstOrDefault(n => n.Id == id)?.Name)
                                .Where(n => n is not null)
                                .ToList();
                            <div class="wr-intel-name">@_selectedNode.Name.ToUpperInvariant()</div>
                            <div class="wr-intel-row">
                                <span class="wr-intel-label">CONTROLLER</span>
                                <span class="@ctrlClass wr-intel-val fw-bold">@ctrlName.ToUpperInvariant()</span>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(_selectedNode.Description))
                            {
                                <div class="wr-intel-row">
                                    <span class="wr-intel-label">SITREP</span>
                                    <span class="wr-intel-val">@_selectedNode.Description</span>
                                </div>
                            }
                            @if (!string.IsNullOrWhiteSpace(_selectedNode.BuffEffect))
                            {
                                <div class="wr-intel-row">
                                    <span class="wr-intel-label">BUFF</span>
                                    <span class="wr-intel-val text-warning">@_selectedNode.BuffEffect</span>
                                </div>
                            }
                            @if (links.Any())
                            {
                                <div class="wr-intel-row">
                                    <span class="wr-intel-label">LINKS</span>
                                    <span class="wr-intel-val">@string.Join(", ", links!)</span>
                                </div>
                            }
                            @if (!string.IsNullOrWhiteSpace(_selectedNode.SecretEventText))
                            {
                                if (!_selectedNode.IsEventRevealed)
                                {
                                    <div class="mt-2">
                                        <button class="btn btn-warning btn-sm w-100" @onclick="RevealEventAsync">
                                            <i class="bi bi-eye-slash me-1"></i> Reveal Hidden Event
                                        </button>
                                    </div>
                                }
                                else
                                {
                                    <div class="wr-secret-event mt-2">
                                        <div class="wr-secret-head">
                                            <i class="bi bi-eye me-1"></i>CLASSIFIED INTEL DECRYPTED
                                        </div>
                                        <div class="wr-secret-body">@_selectedNode.SecretEventText</div>
                                    </div>
                                }
                            }
                        }
                        else
                        {
                            <span class="wr-standby">[ SELECT A NODE ]</span>
                        }
                    </div>
                </div>

                <!-- Command standings -->
                <div class="wr-panel">
                    <div class="wr-panel-head"><i class="bi bi-bar-chart-fill me-2"></i>STANDINGS</div>
                    <div class="wr-panel-body">
                        @foreach (var player in _campaign.Players)
                        {
                            var terr      = _terrByPid.GetValueOrDefault(player.Id);
                            var nameClass = player.Id == "p1" ? "wr-text-p1" : "wr-text-p2";
                            <div class="wr-standing-row">
                                <span class="wr-standing-name @nameClass">@player.Name.ToUpperInvariant()</span>
                                <div class="wr-standing-stats">
                                    <span class="wr-stat"><span class="wr-stat-l">VP</span><span class="wr-stat-v">@player.VictoryPoints</span></span>
                                    <span class="wr-stat"><span class="wr-stat-l">CP</span><span class="wr-stat-v">@player.CampaignPoints</span></span>
                                    <span class="wr-stat"><span class="wr-stat-l">TERR</span><span class="wr-stat-v">@terr</span></span>
                                    <span class="wr-stat"><span class="wr-stat-l text-success">W</span><span class="wr-stat-v text-success">@player.Wins</span></span>
                                    <span class="wr-stat"><span class="wr-stat-l text-danger">L</span><span class="wr-stat-v text-danger">@player.Losses</span></span>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <!-- Engagement log -->
                @if (_campaign.BattleHistory.Any())
                {
                    <div class="wr-panel">
                        <div class="wr-panel-head"><i class="bi bi-clock-history me-2"></i>ENGAGEMENT LOG</div>
                        <div class="wr-panel-body p-0">
                            <table class="wr-table">
                                <thead>
                                    <tr><th>DATE</th><th>MISSION</th><th>VICTOR</th><th>SCORE</th></tr>
                                </thead>
                                <tbody>
                                    @foreach (var b in _campaign.BattleHistory.OrderByDescending(b => b.DatePlayed))
                                    {
                                        var wName  = _campaign.Players.FirstOrDefault(p => p.Id == b.WinnerPlayerId)?.Name ?? b.WinnerPlayerId;
                                        var wClass = b.WinnerPlayerId == "p1" ? "wr-text-p1" : b.WinnerPlayerId == "p2" ? "wr-text-p2" : "";
                                        <tr>
                                            <td class="wr-muted">@b.DatePlayed.ToString("MM-dd")</td>
                                            <td>@b.MissionName</td>
                                            <td class="@wClass fw-bold">@wName.ToUpperInvariant()</td>
                                            <td class="wr-muted">@b.Player1Vp–@b.Player2Vp</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }

            </div>
        </div>
    </div>
}

<style>
    :root { --amber: #c8960c; --amber-bright: #ffc107; --p1: #4da6ff; --p2: #ff5555; }

    .wr-loading {
        display: flex; align-items: center; justify-content: center;
        height: 60vh; font-family: 'Courier New', monospace;
        color: var(--amber); font-size: 1.1rem; letter-spacing: 2px;
    }
    .wr-blink { animation: blink 1.1s step-start infinite; }
    @@keyframes blink { 50% { opacity: 0; } }

    .wr-root { display: flex; flex-direction: column; background: #060810; }

    /* HUD */
    .wr-hud-bar {
        display: flex; align-items: center; justify-content: space-between;
        gap: 12px; background: #060810; border-bottom: 1px solid var(--amber);
        padding: 8px 16px; font-family: 'Courier New', monospace;
        font-size: 0.82rem; color: var(--amber); letter-spacing: 1px; flex-wrap: wrap;
    }
    .wr-hud-left  { display: flex; align-items: center; gap: 10px; }
    .wr-hud-right { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
    .wr-hud-title { font-weight: bold; font-size: 0.9rem; color: var(--amber-bright); }
    .wr-hud-sep   { opacity: 0.35; padding: 0 4px; }
    .wr-campaign-name { color: #ddd; font-size: 0.78rem; }


    .wr-terr-pill {
        font-family: 'Courier New', monospace; font-size: 0.72rem;
        padding: 2px 10px; border-radius: 10px; letter-spacing: 0.5px; border: 1px solid currentColor;
    }
    .wr-pill-p1      { color: var(--p1); border-color: #2a4a7a; background: rgba(77,166,255,0.08); }
    .wr-pill-p2      { color: var(--p2); border-color: #7a2a2a; background: rgba(255,85,85,0.08); }
    .wr-pill-neutral { color: #888; border-color: #444; background: rgba(128,128,128,0.06); }

    /* Territory strip */
    .wr-control-strip { display: flex; height: 4px; width: 100%; overflow: hidden; }
    .wr-strip-p1      { background: var(--p1); }
    .wr-strip-p2      { background: var(--p2); }
    .wr-strip-neutral { background: #444; }

    /* Two-column content row */
    .wr-content { display: flex; align-items: stretch; min-height: 0; }

    .wr-map-col { flex: 1; min-width: 0; }

    .wr-map-shell { position: relative; width: 100%; height: 100%; }
    .wr-scanlines {
        position: absolute; inset: 0; pointer-events: none; z-index: 20;
        background: repeating-linear-gradient(
            to bottom, transparent 0px, transparent 3px,
            rgba(0,0,0,0.18) 3px, rgba(0,0,0,0.18) 4px);
    }

    /* Map fills the left column; aspect-ratio keeps it from stretching */
    .wr-map-col .map-viewport { border-radius: 0; border: none; border-right: 1px solid #1a1a1a; }

    .wr-no-nodes {
        height: 300px; display: flex; align-items: center; justify-content: center;
        font-family: 'Courier New', monospace; color: #555; font-size: 0.88rem; letter-spacing: 1px;
    }

    /* Side panel */
    .wr-side-col {
        width: 300px; flex-shrink: 0;
        border-left: 1px solid var(--amber);
        overflow-y: auto;
        background: #060810;
    }

    .wr-panel { border-bottom: 1px solid #1a1a1a; }
    .wr-panel:last-child { border-bottom: none; }
    .wr-panel-head {
        background: #0a0c14; color: var(--amber);
        font-family: 'Courier New', monospace; font-size: 0.72rem;
        font-weight: bold; letter-spacing: 2px; padding: 7px 12px;
        border-bottom: 1px solid #1a1a1a; position: sticky; top: 0; z-index: 1;
    }
    .wr-panel-body {
        padding: 10px 12px; font-family: 'Courier New', monospace;
        font-size: 0.78rem; color: #bbb;
    }

    /* Intel */
    .wr-intel-name { color: var(--amber-bright); font-size: 0.9rem; font-weight: bold; letter-spacing: 1.5px; margin-bottom: 8px; }
    .wr-intel-row  { display: flex; gap: 8px; margin-bottom: 4px; align-items: baseline; flex-wrap: wrap; }
    .wr-intel-label { font-size: 0.65rem; color: #555; letter-spacing: 1px; min-width: 70px; flex-shrink: 0; }
    .wr-intel-val   { color: #ccc; }
    .wr-standby     { color: #333; font-size: 0.75rem; letter-spacing: 1.5px; display: block; padding-top: 6px; }

    /* Standings */
    .wr-standing-row { margin-bottom: 10px; border-left: 2px solid var(--amber); padding-left: 8px; }
    .wr-standing-name { font-size: 0.8rem; font-weight: bold; letter-spacing: 1px; display: block; margin-bottom: 4px; }
    .wr-standing-stats { display: flex; gap: 8px; flex-wrap: wrap; }
    .wr-stat { display: flex; flex-direction: column; align-items: center; }
    .wr-stat-l { font-size: 0.58rem; color: #555; letter-spacing: 0.5px; }
    .wr-stat-v { font-size: 0.9rem; font-weight: bold; color: var(--amber-bright); }

    /* Colours */
    .wr-text-p1      { color: var(--p1); }
    .wr-text-p2      { color: var(--p2); }
    .wr-text-neutral { color: #888; }

    /* Engagement log */
    .wr-table { width: 100%; border-collapse: collapse; font-family: 'Courier New', monospace; font-size: 0.72rem; }
    .wr-table thead th {
        color: var(--amber); font-size: 0.62rem; letter-spacing: 1px; padding: 5px 12px;
        border-bottom: 1px solid #1a1a1a; background: #080a12; font-weight: normal;
    }
    .wr-table tbody tr { border-bottom: 1px solid #0d0d0d; }
    .wr-table tbody tr:hover { background: #0d0f1a; }
    .wr-table td { padding: 5px 12px; color: #bbb; }
    .wr-muted { color: #555; }

    /* Secret event callout */
    .wr-secret-event {
        border: 1px solid var(--amber);
        border-left: 3px solid var(--amber-bright);
        background: rgba(200, 150, 12, 0.06);
        border-radius: 4px;
        overflow: hidden;
    }
    .wr-secret-head {
        background: rgba(200, 150, 12, 0.15);
        color: var(--amber-bright);
        font-size: 0.62rem;
        font-weight: bold;
        letter-spacing: 1.5px;
        padding: 4px 8px;
        border-bottom: 1px solid rgba(200, 150, 12, 0.2);
    }
    .wr-secret-body {
        padding: 8px;
        color: #ddd;
        font-size: 0.78rem;
        line-height: 1.5;
        white-space: pre-wrap;
    }

    /* Responsive: stack on small screens */
    @@media (max-width: 768px) {
        .wr-content { flex-direction: column; }
        .wr-side-col { width: 100%; border-left: none; border-top: 1px solid var(--amber); }
    }
</style>

@code {
    private Campaign? _campaign;
    private bool _loaded;
    private TerritoryNode? _selectedNode;
    private GmNote? _selectedMapNote;

    private CampaignPlayer? _p1;
    private CampaignPlayer? _p2;
    private int _p1Terr, _p2Terr, _neuTerr, _totalTerr;
    private Dictionary<string, int> _terrByPid = new();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _loaded) return;
        _loaded   = true;
        _campaign = await CampaignSvc.LoadCampaignAsync();
        RefreshStats();
        StateHasChanged();
    }

    private void RefreshStats()
    {
        if (_campaign is null) return;
        _p1 = _campaign.Players.FirstOrDefault(p => p.Id == "p1");
        _p2 = _campaign.Players.FirstOrDefault(p => p.Id == "p2");

        _terrByPid.Clear();
        foreach (var node in _campaign.MapNodes)
        {
            var pid = node.ControllingPlayerId;
            if (!string.IsNullOrEmpty(pid))
                _terrByPid[pid] = _terrByPid.GetValueOrDefault(pid) + 1;
        }

        _p1Terr    = _terrByPid.GetValueOrDefault("p1");
        _p2Terr    = _terrByPid.GetValueOrDefault("p2");
        _neuTerr   = _campaign.MapNodes.Count - _terrByPid.Values.Sum();
        _totalTerr = _campaign.MapNodes.Count;
    }

    private void HandleNodeSelected(string nodeId)
    {
        _selectedNode    = _campaign?.MapNodes.FirstOrDefault(n => n.Id == nodeId);
        _selectedMapNote = _selectedNode is null
            ? _campaign?.GmNotebook.FirstOrDefault(n => n.IsPublic && n.X >= 0 && n.Id == nodeId)
            : null;
        StateHasChanged();
    }

    private async Task RevealEventAsync()
    {
        if (_selectedNode is null || _campaign is null) return;
        _selectedNode.IsEventRevealed = true;
        await CampaignSvc.SaveCampaignAsync(_campaign);
    }
}
