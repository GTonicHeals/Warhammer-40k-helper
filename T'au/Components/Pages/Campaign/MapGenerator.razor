@page "/map-generator"
@rendermode InteractiveServer
@using System.Globalization
@using Warhammer.Helpers
@using Warhammer.Models.Campaign
@using Warhammer.Services
@inject CampaignManagerService CampaignSvc
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>Map Generator</PageTitle>

<div class="mg-root">

    <!-- Controls panel -->
    <div class="mg-controls">
        <div class="mg-header">
            <button class="btn btn-sm btn-outline-secondary" @onclick='() => Nav.NavigateTo("/campaign-editor")'>
                <i class="bi bi-arrow-left"></i>
            </button>
            <span class="mg-title">MAP GENERATOR</span>
        </div>

        @if (!_loaded)
        {
            <p class="mg-hint mt-3">Loading…</p>
        }
        else
        {
            <!-- Seed -->
            <div class="mg-section">
                <div class="mg-row">
                    <label class="mg-label">SEED</label>
                    <input class="form-control form-control-sm mg-seed-input"
                           type="number" min="1" max="999999"
                           value="@_seed"
                           @onchange="e => { _seed = int.TryParse(e.Value?.ToString(), out var v) ? Math.Clamp(v,1,999999) : _seed; OnParamChanged(); }" />
                    <button class="btn btn-sm btn-outline-warning ms-1 flex-shrink-0" @onclick="Randomize" title="Random seed">
                        <i class="bi bi-dice-5"></i>
                    </button>
                </div>
            </div>

            <!-- Biome -->
            <div class="mg-section">
                <label class="mg-label">BIOME</label>
                <select id="mg-biome" class="form-select form-select-sm bg-dark text-warning border-secondary mt-1"
                        value="@_biome"
                        @onchange="OnBiomeChanged">
                    @foreach (var biome in BiomeCatalog.All)
                    {
                        <option value="@biome.Key">@biome.Label</option>
                    }
                </select>
                <p class="mg-hint">Picking a Biome resets Sea level and Rivers to its defaults</p>
            </div>

            <!-- Sea level -->
            <div class="mg-section">
                <div class="mg-param-header">
                    <label class="mg-label">SEA LEVEL</label>
                    <span class="mg-val">@((int)Math.Round(_seaLevel * 100))%</span>
                </div>
                <input id="mg-sea" type="range" class="form-range mg-range" min="0" max="0.85" step="0.01"
                       value="@Inv(_seaLevel)"
                       @oninput="e => { _seaLevel = ParseD(e.Value, _seaLevel); OnParamChanged(); }" />
                <p class="mg-hint">How much of the World Surface is sea (lakes come on top)</p>
            </div>

            <!-- Landmass -->
            <div class="mg-section">
                <label class="mg-label">LANDMASS</label>
                <select id="mg-landmass" class="form-select form-select-sm bg-dark text-warning border-secondary mt-1"
                        value="@_landmass"
                        @onchange="e => { _landmass = e.Value?.ToString() ?? _landmass; OnParamChanged(); }">
                    @foreach (var l in LandmassCatalog.All)
                    {
                        <option value="@l.Key" selected="@(l.Key == _landmass)">@l.Label</option>
                    }
                </select>
            </div>

            <!-- Rivers -->
            <div class="mg-section">
                <div class="mg-param-header">
                    <label class="mg-label">RIVERS</label>
                    <span class="mg-val">@_rivers</span>
                </div>
                <input id="mg-rivers" type="range" class="form-range mg-range" min="0" max="12" step="1"
                       value="@_rivers"
                       @oninput="e => { _rivers = int.TryParse(e.Value?.ToString(), out var v) ? v : _rivers; OnParamChanged(); }" />
            </div>

            <!-- Ruggedness -->
            <div class="mg-section">
                <div class="mg-param-header">
                    <label class="mg-label">RUGGEDNESS</label>
                    <span class="mg-val">@_ruggedness.ToString("F2", CultureInfo.InvariantCulture)</span>
                </div>
                <input id="mg-ruggedness" type="range" class="form-range mg-range" min="0" max="1" step="0.05"
                       value="@Inv(_ruggedness)"
                       @oninput="e => { _ruggedness = ParseD(e.Value, _ruggedness); OnParamChanged(); }" />
                <p class="mg-hint">Relief shading and ridge strength</p>
            </div>

            <!-- Features -->
            <div class="mg-section">
                <div class="mg-param-header">
                    <label class="mg-label">FEATURES</label>
                    <span class="mg-val">@_features.ToString("F2", CultureInfo.InvariantCulture)</span>
                </div>
                <input id="mg-features" type="range" class="form-range mg-range" min="0" max="1" step="0.05"
                       value="@Inv(_features)"
                       @oninput="e => { _features = ParseD(e.Value, _features); OnParamChanged(); }" />
                <p class="mg-hint">Density of scattered Biome features</p>
            </div>

            <!-- Offset X -->
            <div class="mg-section">
                <div class="mg-param-header">
                    <label class="mg-label">OFFSET X</label>
                    <span class="mg-val">@_offsetX.ToString("F1", CultureInfo.InvariantCulture)</span>
                </div>
                <input type="range" class="form-range mg-range" min="-5.0" max="5.0" step="0.1"
                       value="@Inv(_offsetX)"
                       @oninput="e => { _offsetX = ParseD(e.Value, _offsetX); OnParamChanged(); }" />
            </div>

            <!-- Offset Y -->
            <div class="mg-section">
                <div class="mg-param-header">
                    <label class="mg-label">OFFSET Y</label>
                    <span class="mg-val">@_offsetY.ToString("F1", CultureInfo.InvariantCulture)</span>
                </div>
                <input type="range" class="form-range mg-range" min="-5.0" max="5.0" step="0.1"
                       value="@Inv(_offsetY)"
                       @oninput="e => { _offsetY = ParseD(e.Value, _offsetY); OnParamChanged(); }" />
            </div>

            <!-- Advanced noise parameters -->
            <details class="mg-advanced">
                <summary>ADVANCED</summary>

                <div class="mg-section">
                    <div class="mg-param-header">
                        <label class="mg-label">SCALE</label>
                        <span class="mg-val">@_scale.ToString("F1", CultureInfo.InvariantCulture)</span>
                    </div>
                    <input type="range" class="form-range mg-range" min="0.5" max="8.0" step="0.1"
                           value="@Inv(_scale)"
                           @oninput="e => { _scale = ParseD(e.Value, _scale); OnParamChanged(); }" />
                    <p class="mg-hint">Higher = more, smaller features</p>
                </div>

                <div class="mg-section">
                    <div class="mg-param-header">
                        <label class="mg-label">OCTAVES</label>
                        <span class="mg-val">@_octaves</span>
                    </div>
                    <input type="range" class="form-range mg-range" min="1" max="8" step="1"
                           value="@_octaves"
                           @oninput="e => { _octaves = int.TryParse(e.Value?.ToString(), out var v) ? v : _octaves; OnParamChanged(); }" />
                    <p class="mg-hint">More octaves → finer detail layers</p>
                </div>

                <div class="mg-section">
                    <div class="mg-param-header">
                        <label class="mg-label">LACUNARITY</label>
                        <span class="mg-val">@_lacunarity.ToString("F2", CultureInfo.InvariantCulture)</span>
                    </div>
                    <input type="range" class="form-range mg-range" min="1.0" max="4.0" step="0.05"
                           value="@Inv(_lacunarity)"
                           @oninput="e => { _lacunarity = ParseD(e.Value, _lacunarity); OnParamChanged(); }" />
                    <p class="mg-hint">Frequency multiplier per octave</p>
                </div>

                <div class="mg-section">
                    <div class="mg-param-header">
                        <label class="mg-label">PERSISTENCE</label>
                        <span class="mg-val">@_persistence.ToString("F2", CultureInfo.InvariantCulture)</span>
                    </div>
                    <input type="range" class="form-range mg-range" min="0.1" max="0.95" step="0.05"
                           value="@Inv(_persistence)"
                           @oninput="e => { _persistence = ParseD(e.Value, _persistence); OnParamChanged(); }" />
                    <p class="mg-hint">Amplitude decay per octave</p>
                </div>
            </details>

            <!-- Actions -->
            <div class="mg-actions">
                <button class="btn btn-warning w-100 mb-2" @onclick="ApplyAsync" disabled="@_saving">
                    @if (_saving)
                    {
                        <span class="spinner-border spinner-border-sm me-2"></span>
                    }
                    <i class="bi bi-check2-circle me-1"></i> Apply to Campaign
                </button>
                <button class="btn btn-outline-secondary w-100" @onclick='() => Nav.NavigateTo("/campaign-editor")'>
                    Cancel
                </button>
            </div>
        }
    </div>

    <!-- Preview panel -->
    <div class="mg-preview">
        <div class="mg-canvas-wrap">
            <canvas id="map-gen-canvas" class="mg-canvas"></canvas>
            @if (!_loaded)
            {
                <div class="mg-overlay"><span class="mg-blink">[ INITIALISING ]</span></div>
            }
        </div>
        <p class="mg-preview-hint">
            <i class="bi bi-info-circle me-1"></i>Adjust parameters to preview — changes apply instantly.
        </p>
    </div>

</div>

<style>
    .mg-root {
        display: flex;
        height: calc(100vh - 56px); /* subtract nav height */
        overflow: hidden;
        background: #060810;
    }

    /* Controls */
    .mg-controls {
        width: 280px;
        flex-shrink: 0;
        border-right: 1px solid #c8960c;
        overflow-y: auto;
        padding: 14px 14px 20px;
        background: #08090f;
        display: flex;
        flex-direction: column;
        gap: 0;
    }
    .mg-header {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 16px;
    }
    .mg-title {
        font-family: 'Courier New', monospace;
        font-size: 0.82rem;
        font-weight: bold;
        letter-spacing: 2px;
        color: #c8960c;
    }
    .mg-section {
        border-top: 1px solid #1a1a1a;
        padding: 10px 0 6px;
    }
    .mg-label {
        font-family: 'Courier New', monospace;
        font-size: 0.65rem;
        letter-spacing: 1.5px;
        color: #666;
        display: block;
        margin-bottom: 2px;
    }
    .mg-param-header {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        margin-bottom: 2px;
    }
    .mg-val {
        font-family: 'Courier New', monospace;
        font-size: 0.82rem;
        color: #ffc107;
        font-weight: bold;
    }
    .mg-hint {
        font-size: 0.68rem;
        color: #9a9a9a;
        margin: 2px 0 0;
    }
    .mg-range { accent-color: #c8960c; }
    .mg-seed-input {
        background: #111 !important;
        color: #ffc107 !important;
        border-color: #333 !important;
        font-family: 'Courier New', monospace;
        font-size: 0.82rem;
        max-width: 100px;
    }
    .mg-advanced { border-top: 1px solid #1a1a1a; padding: 10px 0 0; }
    .mg-advanced > summary {
        font-family: 'Courier New', monospace;
        font-size: 0.65rem;
        letter-spacing: 1.5px;
        color: #c8960c;
        cursor: pointer;
        padding-bottom: 6px;
    }
    .mg-row { display: flex; align-items: center; gap: 6px; }
    .mg-actions { margin-top: auto; padding-top: 16px; border-top: 1px solid #1a1a1a; }

    /* Preview */
    .mg-preview {
        flex: 1;
        min-width: 0;
        display: flex;
        flex-direction: column;
        padding: 16px;
        gap: 8px;
    }
    .mg-canvas-wrap {
        position: relative;
        flex: 1;
        min-height: 0;
        container-type: size;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    /* Always the Campaign Map's 16:9, letterboxed in the wrap; the renderer stretches the world to the canvas. */
    .mg-canvas {
        width: min(100cqw, 100cqh * 16 / 9);
        aspect-ratio: 16 / 9;
        height: auto;
        display: block;
    }
    .mg-overlay {
        position: absolute;
        inset: 0;
        background: rgba(6,8,16,0.75);
        display: flex;
        align-items: center;
        justify-content: center;
        font-family: 'Courier New', monospace;
        color: #c8960c;
        font-size: 1rem;
        letter-spacing: 3px;
    }
    .mg-blink { animation: blink 1s step-start infinite; }
    @@keyframes blink { 50% { opacity: 0; } }
    .mg-preview-hint {
        font-size: 0.72rem;
        color: #9a9a9a;
        margin: 0;
        font-family: 'Courier New', monospace;
        letter-spacing: 0.5px;
    }

    @@media (max-width: 640px) {
        .mg-root { flex-direction: column; height: auto; overflow: visible; }
        .mg-controls { width: 100%; border-right: none; border-bottom: 1px solid #c8960c; }
        /* The preview leads and stays in view while the sliders below it are dragged. */
        .mg-preview { order: -1; position: sticky; top: 0; z-index: 5; background: #060810; padding: 8px; border-bottom: 1px solid #c8960c; }
        .mg-canvas-wrap { flex: none; height: 210px; min-height: 0; }
        .mg-preview-hint { display: none; }
        .mg-label { font-size: 0.75rem; color: #8a8a8a; }
        .mg-hint { font-size: 0.75rem; }
        .mg-seed-input { max-width: 140px; }
        .mg-range { height: 2rem; }
        .mg-advanced > summary { font-size: 0.75rem; padding: 6px 0; }
    }
</style>

@code {
    private Campaign? _campaign;
    private bool _loaded;
    private bool _saving;
    private bool _needsRedraw;

    private int    _seed        = 1;
    private string _biome       = "agri";
    private double _seaLevel    = 0.35;
    private string _landmass    = "continent";
    private int    _rivers      = 4;
    private double _ruggedness  = 0.5;
    private double _features    = 0.5;
    private int    _octaves     = 4;
    private double _lacunarity  = 2.0;
    private double _persistence = 0.5;
    private double _scale       = 2.0;
    private double _offsetX     = 0.0;
    private double _offsetY     = 0.0;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _campaign    = await CampaignSvc.LoadCampaignAsync();
            var surface  = WorldSurfaceSettings.From(_campaign); // normalises legacy Biome / Landmass keys
            _seed        = _campaign.MapSeed;
            _biome       = surface.Biome;
            _landmass    = surface.Landmass;
            _seaLevel    = _campaign.MapSeaLevel;
            _rivers      = _campaign.MapRivers;
            _ruggedness  = _campaign.MapRuggedness;
            _features    = _campaign.MapFeatures;
            _octaves     = _campaign.MapOctaves;
            _lacunarity  = _campaign.MapLacunarity;
            _persistence = _campaign.MapPersistence;
            _scale       = _campaign.MapScale;
            _offsetX     = _campaign.MapOffsetX;
            _offsetY     = _campaign.MapOffsetY;
            _loaded      = true;
            _needsRedraw = true;
            StateHasChanged();
            return;
        }

        if (_needsRedraw)
        {
            _needsRedraw = false;
            await PreviewAsync();
        }
    }

    private void OnParamChanged() => _needsRedraw = true;

    private static string Inv(double v) => v.ToString(CultureInfo.InvariantCulture);

    private static double ParseD(object? raw, double fallback) =>
        double.TryParse(raw?.ToString(), NumberStyles.Float, CultureInfo.InvariantCulture, out var v) ? v : fallback;

    // Only the Map Generator applies Biome defaults; nothing is saved until Apply.
    private void OnBiomeChanged(ChangeEventArgs e)
    {
        var biome = BiomeCatalog.Get(e.Value?.ToString());
        _biome    = biome.Key;
        _seaLevel = biome.DefaultSeaLevel;
        _rivers   = biome.DefaultRivers;
        OnParamChanged();
    }

    private void Randomize()
    {
        _seed = Random.Shared.Next(1, 999_999);
        OnParamChanged();
    }

    private WorldSurfaceSettings CurrentSettings() => new(
        _seed, _biome, _seaLevel, _landmass, _rivers, _ruggedness, _features,
        _octaves, _lacunarity, _persistence, _scale, _offsetX, _offsetY);

    private async Task PreviewAsync()
    {
        await JS.InvokeVoidAsync("topoMapInterop.drawById", "map-gen-canvas", CurrentSettings());
    }

    private async Task ApplyAsync()
    {
        if (_campaign is null) return;
        _saving = true;
        _campaign.MapSeed        = _seed;
        _campaign.MapBiome       = _biome;
        _campaign.MapSeaLevel    = _seaLevel;
        _campaign.MapLandmass    = _landmass;
        _campaign.MapRivers      = _rivers;
        _campaign.MapRuggedness  = _ruggedness;
        _campaign.MapFeatures    = _features;
        _campaign.MapOctaves     = _octaves;
        _campaign.MapLacunarity  = _lacunarity;
        _campaign.MapPersistence = _persistence;
        _campaign.MapScale       = _scale;
        _campaign.MapOffsetX     = _offsetX;
        _campaign.MapOffsetY     = _offsetY;
        await CampaignSvc.SaveCampaignAsync(_campaign);
        Nav.NavigateTo("/campaign-editor");
    }
}
