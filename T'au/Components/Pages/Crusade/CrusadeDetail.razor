@code {
    [Parameter] public string Id { get; set; } = "";

    private record AvailableUnit(string Name, int Points);

    private bool _loaded;
    private OrderOfBattle? _crusade;

    private List<AvailableUnit> _availableUnits = new();
    // Keep the raw Selection objects so the weapon picker can read each unit's
    // weapon list when applying a per-weapon honour.
    private Dictionary<string, Selection> _selectionsByName = new(StringComparer.OrdinalIgnoreCase);
    private string _selectedUnitKey = "";
    private bool _newUnitCharacter;
    private bool _showAddUnitModal = false;
    private void OpenAddUnitModal() => _showAddUnitModal = true;
    private void CloseAddUnitModal() { _showAddUnitModal = false; _selectedUnitKey = ""; _unitSearch = ""; }

    private string _unitSearch = "";
    private IEnumerable<AvailableUnit> FilteredUnits =>
        string.IsNullOrWhiteSpace(_unitSearch)
            ? _availableUnits
            : _availableUnits.Where(u => u.Name.Contains(_unitSearch.Trim(), StringComparison.OrdinalIgnoreCase));

    // Per-unit dropdown state (transient — not persisted)
    private readonly Dictionary<string, string> _scarChoice = new();

    // Per-unit upgrade panel open/closed state (transient)
    private readonly Dictionary<string, bool> _upgradePanelOpen = new();
    private void ToggleUpgradePanel(string unitId) =>
        _upgradePanelOpen[unitId] = !_upgradePanelOpen.GetValueOrDefault(unitId);

    // Custom-trait form state
    private string _newTraitType = CrusadeTraitTypes.CrusadeRelic;
    private string _newTraitCategory = "";
    private string _newTraitName = "";
    private string _newTraitEffect = "";

    // Trait details modal (click on an honour/scar badge to open)
    private AppliedTrait? _modalTrait;
    private void ShowTraitModal(AppliedTrait t) => _modalTrait = t;
    private void CloseTraitModal() => _modalTrait = null;

    // Id of the crusade currently loaded. The router reuses this component when only {Id}
    // changes (e.g. sidebar crusade → crusade), so a changed Id must trigger a fresh load.
    private string? _loadedId;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _loaded) return;
        await LoadAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedId is null || _loadedId == Id) return;

        _loaded = false;
        _crusade = null;
        _availableUnits = new();
        _selectionsByName = new(StringComparer.OrdinalIgnoreCase);
        _ambiguousSizes.Clear();
        _upgradePanelOpen.Clear();
        _scarChoice.Clear();
        _showRequisitions = false;
        _buying = null;
        _modalTrait = null;
        _newTraitCategory = _newTraitName = _newTraitEffect = "";
        CloseAddUnitModal();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loadedId = Id;
        await Traits.EnsureLoadedAsync();
        await CrusadeMgr.LoadAllCrusadesAsync();
        _crusade = CrusadeMgr.GetCrusade(Id);

        if (_crusade != null && !string.IsNullOrEmpty(_crusade.PlayerId))
        {
            var roster = await RosterLoader.LoadRosterAsync(_crusade.PlayerId);
            if (roster != null)
            {
                var all = RosterLoadService.GetPlayableUnits(roster).ToList();
                // Same datasheet taken twice at different sizes: the roster cannot say which card is which.
                _ambiguousSizes = all.GroupBy(u => u.Name, StringComparer.OrdinalIgnoreCase)
                    .Where(g => g.Select(UnitStrength.FromRoster).Distinct().Count() > 1)
                    .Select(g => g.Key)
                    .ToHashSet(StringComparer.OrdinalIgnoreCase);
                var sels = all
                    .DistinctBy(u => u.Name)
                    .ToList();
                _selectionsByName = sels.ToDictionary(s => s.Name, StringComparer.OrdinalIgnoreCase);
                _availableUnits = sels
                    .Select(u => new AvailableUnit(u.Name, GetPoints(u)))
                    .OrderBy(u => u.Name)
                    .ToList();
            }
        }

        _requisitions = (await CampaignSvc.LoadCampaignAsync()).Requisitions;

        // Cards added before attrition existed have no unit size; take it from the roster once.
        if (_crusade is not null)
        {
            var filled = false;
            foreach (var card in _crusade.Units.Where(c => c.ModelCount == 0))
                filled |= FillStrengthFromRoster(card);
            if (filled) await SaveAsync();
        }

        _loaded = true;
        StateHasChanged();
    }

    // Sets the unit size and wounds from the matching roster datasheet. False when the roster cannot tell.
    private HashSet<string> _ambiguousSizes = new(StringComparer.OrdinalIgnoreCase);

    private bool FillStrengthFromRoster(CrusadeUnitCard card)
    {
        if (_ambiguousSizes.Contains(card.DatasheetName ?? "")) return false;
        if (!_selectionsByName.TryGetValue(card.DatasheetName ?? "", out var sel)) return false;
        var (count, wounds) = UnitStrength.FromRoster(sel);
        if (count == 0) return false;
        card.ModelCount = count;
        card.WoundsPerModel = wounds;
        UnitStrength.Clamp(card);
        return true;
    }

    // Keeps the damage inside what the (possibly just edited) unit size allows.
    private async Task SaveStrengthAsync(CrusadeUnitCard card)
    {
        UnitStrength.Clamp(card);
        await SaveAsync();
    }

    private static int GetPoints(Selection unit)
    {
        var cost = unit.Costs?.FirstOrDefault(c => c.Name == "pts");
        return cost is null ? 0 : (int)Math.Round(cost.Value);
    }

    // ── Requisitions ───────────────────────────────────────────────────
    private List<Requisition> _requisitions = new();
    private bool _showRequisitions;
    private Requisition? _buying;
    private int? _buyCost;   // null = nothing valid typed

    private void ToggleRequisitions()
    {
        _showRequisitions = !_showRequisitions;
        _buying = null;
    }

    private void PickRequisition(Requisition req)
    {
        _buying = req;
        _buyCost = req.Cost;
    }

    private async Task BuyAsync()
    {
        if (_crusade is null || _buying is null || _buyCost is not { } cost) return;
        if (RequisitionRules.CannotBuy(_crusade, cost) is not null) return;
        RequisitionRules.Buy(_crusade, _buying, cost, DateTime.UtcNow);
        _buying = null;
        await SaveAsync();
    }

    private async Task SaveAsync()
    {
        if (_crusade is null) return;
        await CrusadeMgr.SaveCrusadeAsync(_crusade);
    }

    // Player armies list first in the Wound Calculator, the Game Master's after them.
    private async Task SetGmArmy(bool isGm)
    {
        if (_crusade is null || _crusade.IsGmArmy == isGm) return;
        _crusade.IsGmArmy = isGm;
        await SaveAsync();
    }

    private async Task IncRp()
    {
        if (_crusade is null || _crusade.RequisitionPoints >= OrderOfBattle.RequisitionPointsMax) return;
        _crusade.RequisitionPoints++;
        await SaveAsync();
    }

    private async Task DecRp()
    {
        if (_crusade is null || _crusade.RequisitionPoints <= 0) return;
        _crusade.RequisitionPoints--;
        await SaveAsync();
    }

    private CrusadeUnitFlags FlagsFor(string unitName) =>
        CrusadeUnitFlags.FromKeywords(_selectionsByName.TryGetValue(unitName, out var sel)
            ? RosterHelper.GetKeywords(sel)
            : []);

    // Picking a tile defaults the CHARACTER checkbox from the datasheet keywords.
    private void PickUnit(string name)
    {
        _selectedUnitKey = name;
        _newUnitCharacter = FlagsFor(name).IsCharacter;
    }

    private async Task AddUnit()
    {
        if (_crusade is null || string.IsNullOrEmpty(_selectedUnitKey)) return;

        var available = _availableUnits.FirstOrDefault(u => string.Equals(u.Name, _selectedUnitKey, StringComparison.OrdinalIgnoreCase));
        if (available is null) return;

        var flags = FlagsFor(available.Name);
        var added = new CrusadeUnitCard
        {
            UnitName = available.Name,
            DatasheetName = available.Name,
            TotalPoints = available.Points,
            IsCharacter = _newUnitCharacter,
            IsTitanic = flags.IsTitanic,
            XpEligible = flags.XpEligible
        };
        FillStrengthFromRoster(added);
        _crusade.Units.Add(added);

        CloseAddUnitModal();
        _newUnitCharacter = false;
        await SaveAsync();
    }

    private async Task RemoveUnit(string unitId)
    {
        if (_crusade is null) return;
        var confirmed = await JS.InvokeAsync<bool>("confirm", "Remove this unit from the Order of Battle?");
        if (!confirmed) return;
        _crusade.Units.RemoveAll(u => u.Id == unitId);
        _scarChoice.Remove(unitId);
        await SaveAsync();
    }

    private Selection? RosterUnitOf(CrusadeUnitCard unit) =>
        _selectionsByName.TryGetValue(unit.DatasheetName ?? "", out var sel) ? sel : null;

    private async Task AddHonour(CrusadeUnitCard unit, AppliedTrait applied)
    {
        if (_crusade is null) return;
        unit.BattleHonours.Add(applied);
        await SaveAsync();
    }

    private async Task RemoveHonour(CrusadeUnitCard unit, int index)
    {
        if (_crusade is null || index < 0 || index >= unit.BattleHonours.Count) return;
        var removed = unit.BattleHonours[index];
        unit.BattleHonours.RemoveAt(index);
        await SaveAsync();
    }

    // ── Scar dropdown state ────────────────────────────────────────────
    private string GetScarChoice(string unitId) => _scarChoice.TryGetValue(unitId, out var v) ? v : "";
    private void SetScarChoice(string unitId, string value) => _scarChoice[unitId] = value;

    private async Task AddScar(CrusadeUnitCard unit)
    {
        if (_crusade is null) return;
        var name = GetScarChoice(unit.Id);
        if (string.IsNullOrEmpty(name)) return;

        var trait = Traits.ByType(CrusadeTraitTypes.BattleScar).FirstOrDefault(t => t.Name == name);
        if (trait is null) return;

        unit.BattleScars.Add(AppliedTrait.FromTrait(trait));
        _scarChoice[unit.Id] = "";
        await SaveAsync();
    }

    private async Task RemoveScar(CrusadeUnitCard unit, int index)
    {
        if (_crusade is null || index < 0 || index >= unit.BattleScars.Count) return;
        unit.BattleScars.RemoveAt(index);
        await SaveAsync();
    }

    // ── Custom traits (crusade-scoped relics, etc.) ────────────────────
    private async Task AddCustomTrait()
    {
        if (_crusade is null) return;
        if (string.IsNullOrWhiteSpace(_newTraitName) || string.IsNullOrWhiteSpace(_newTraitEffect)) return;

        _crusade.CustomTraits.Add(new CrusadeTrait
        {
            Type = _newTraitType,
            Category = (_newTraitCategory ?? "").Trim(),
            Name = _newTraitName.Trim(),
            Effect = _newTraitEffect.Trim()
        });

        _newTraitCategory = "";
        _newTraitName = "";
        _newTraitEffect = "";
        await SaveAsync();
    }

    private async Task RemoveCustomTrait(CrusadeTrait trait)
    {
        if (_crusade is null) return;
        _crusade.CustomTraits.Remove(trait);
        await SaveAsync();
    }

    private static string RankLabel(CrusadeRank rank) => RankCalculator.Label(rank);
}
