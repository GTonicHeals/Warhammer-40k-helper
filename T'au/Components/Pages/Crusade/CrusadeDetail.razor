@page "/crusade/{Id}"
@rendermode InteractiveServer
@using Warhammer.Helpers
@using Warhammer.Models
@using Warhammer.Models.Crusade
@using Warhammer.Models.Campaign
@using Warhammer.Services.Crusade
@using Warhammer.Services
@using Warhammer.Components.Pages.Battle
@inject CrusadeManagerService CrusadeMgr
@inject CampaignManagerService CampaignSvc
@inject RosterLoadService RosterLoader
@inject CrusadeTraitsService Traits
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>Crusade — @(_crusade?.ArmyName ?? "...")</PageTitle>

<div class="rules-container">
    @if (!_loaded)
    {
        <p class="text-center text-muted"><em>Loading…</em></p>
    }
    else if (_crusade is null)
    {
        <div class="alert alert-warning">
            Crusade not found. <a href="crusade" class="alert-link">Back to manager</a>.
        </div>
    }
    else
    {
        <div class="d-flex align-items-center justify-content-between mb-3 crusade-head">
            <input class="form-control form-control-lg crusade-title-input"
                   @bind="_crusade.ArmyName" @bind:after="SaveAsync"
                   placeholder="Unnamed Crusade" />
            <div class="btn-group ms-2 flex-shrink-0" role="group" aria-label="Who plays this army">
                <button type="button" class="btn @(!_crusade.IsGmArmy ? "btn-warning" : "btn-outline-warning")"
                        aria-pressed="@(!_crusade.IsGmArmy ? "true" : "false")" @onclick="() => SetGmArmy(false)">
                    <i class="bi bi-person-fill me-1"></i>Player
                </button>
                <button type="button" class="btn @(_crusade.IsGmArmy ? "btn-warning" : "btn-outline-warning")"
                        aria-pressed="@(_crusade.IsGmArmy ? "true" : "false")" @onclick="() => SetGmArmy(true)">
                    <i class="bi bi-eye-fill me-1"></i>GM
                </button>
            </div>
            <a href="crusade" class="btn btn-outline-secondary ms-2 text-nowrap flex-shrink-0"><i class="bi bi-arrow-left"></i> Back</a>
        </div>     

        <div class="row g-3 mb-4">
            <div class="col-md-4">
                <label class="form-label text-warning fw-bold">Faction</label>
                <input class="form-control bg-dark text-white border-secondary"
                       @bind="_crusade.Faction" @bind:after="SaveAsync" />
            </div>
            <div class="col-md-3">
                <label class="form-label text-warning fw-bold">Supply Limit</label>
                <input type="number" min="0" class="form-control bg-dark text-white border-secondary"
                       @bind="_crusade.SupplyLimit" @bind:after="SaveAsync" />
            </div>
            <div class="col-md-3">
                <label class="form-label text-warning fw-bold">Supply Used</label>
                @{
                    var over = _crusade.SupplyUsed > _crusade.SupplyLimit;
                    var pct = _crusade.SupplyLimit > 0 ? Math.Min(100, _crusade.SupplyUsed * 100 / _crusade.SupplyLimit) : 0;
                }
                <div class="supply-stat" title="Points of all units in the Order of Battle">
                    <span class="fw-bold" style="color: @(over ? "#ff6b6b" : "#fff");">@_crusade.SupplyUsed / @_crusade.SupplyLimit</span>
                    <div class="progress mt-1" style="height: 6px; background: #2a2a2a;" role="progressbar"
                         aria-label="Supply used" aria-valuenow="@pct" aria-valuemin="0" aria-valuemax="100">
                        <div class="progress-bar @(over ? "bg-danger" : "bg-warning")" style="width: @(pct)%"></div>
                    </div>
                </div>
            </div>
            <div class="col-md-2">
                <label class="form-label text-warning fw-bold">Req. Points</label>
                <div class="input-group">
                    <button class="btn btn-outline-warning" @onclick="DecRp"
                            disabled="@(_crusade.RequisitionPoints <= 0)">−</button>
                    <span class="form-control bg-dark text-center text-white border-secondary">
                        @_crusade.RequisitionPoints / @OrderOfBattle.RequisitionPointsMax
                    </span>
                    <button class="btn btn-outline-warning" @onclick="IncRp"
                            disabled="@(_crusade.RequisitionPoints >= OrderOfBattle.RequisitionPointsMax)">+</button>
                </div>
                <button class="btn btn-sm btn-outline-warning w-100 mt-1" id="req-open" @onclick="ToggleRequisitions">
                    <i class="bi bi-box-seam me-1"></i>Requisitions
                </button>
            </div>
        </div>

        @if (_showRequisitions)
        {
            <div class="card bg-dark border-secondary mb-4" id="req-panel">
                <div class="card-header border-secondary d-flex align-items-center">
                    <span class="text-warning fw-bold flex-grow-1"><i class="bi bi-box-seam me-2"></i>Requisitions</span>
                    <span class="small text-secondary me-3">@_crusade.RequisitionPoints Requisition Point@(_crusade.RequisitionPoints == 1 ? "" : "s") to spend</span>
                    <button type="button" class="btn-close btn-close-white" aria-label="Close" @onclick="ToggleRequisitions"></button>
                </div>
                <div class="card-body">
                    @if (_requisitions.Count == 0)
                    {
                        <p class="text-secondary mb-0"><em>The Campaign has no Requisitions. Add some in the Campaign Editor.</em></p>
                    }
                    @foreach (var r in _requisitions)
                    {
                        var req = r;
                        <div class="d-flex align-items-start gap-3 py-2 border-bottom border-secondary">
                            <div class="flex-grow-1">
                                <div class="text-white fw-bold">@req.Name <span class="badge bg-warning text-dark ms-1">@(req.Cost == 0 ? "Free" : $"{req.Cost} RP")</span></div>
                                <div class="small text-secondary">@req.Timing</div>
                                <div class="small">@req.Effect</div>
                            </div>
                            <button class="btn btn-sm btn-warning flex-shrink-0" data-buy="@req.Id" @onclick="() => PickRequisition(req)">Buy</button>
                        </div>
                    }
                </div>
            </div>
        }

        @if (_crusade.RequisitionLog.Count > 0)
        {
            <div class="mb-4" id="req-log">
                <div class="small text-warning fw-bold mb-1">Requisitions bought</div>
                @foreach (var entry in Enumerable.Reverse(_crusade.RequisitionLog))
                {
                    <div class="small text-secondary" data-req-log>
                        @entry.DateUtc.ToLocalTime().ToString("d MMM yyyy") · <span class="text-white">@entry.Name</span> · @entry.Cost RP
                    </div>
                }
            </div>
        }

        <h3 class="text-warning"><i class="bi bi-people"></i> Order of Battle (@_crusade.Units.Count)</h3>

        <div class="add-unit-form mb-3">
            @if (string.IsNullOrEmpty(_crusade.PlayerId))
            {
                <p class="text-muted mb-0">
                    <em>Add Unit unavailable — no bound player roster.</em>
                </p>
            }
            else if (_availableUnits.Count == 0)
            {
                <p class="text-muted mb-0">
                    <em>No units found in roster <code>@_crusade.PlayerId</code>. Check that the roster file contains units.</em>
                </p>
            }
            else
            {
                <button class="btn btn-warning w-100 py-2 fw-bold" @onclick="OpenAddUnitModal">
                    <i class="bi bi-plus-circle me-2"></i> Select Unit to Add
                </button>
            }
        </div>

        <details class="add-custom-trait-form mb-3" open="@_crusade.CustomTraits.Any()">
            <summary class="text-warning fw-semibold mb-2" style="cursor:pointer;">
                <i class="bi bi-stars"></i> Custom Relics &amp; Traits
                <span class="text-muted small">(@_crusade.CustomTraits.Count)</span>
            </summary>
            <p class="small text-muted mb-2">
                Add Crusade Relics or Battle Traits not in the static rules data. They appear in the honour dropdowns for every unit in this crusade.
            </p>
            <div class="row g-2 align-items-end">
                <div class="col-md-2">
                    <label class="form-label small text-warning mb-0">Type</label>
                    <select class="form-select form-select-sm bg-dark text-white border-secondary" @bind="_newTraitType">
                        <option value="@CrusadeTraitTypes.CrusadeRelic">@CrusadeTraitTypes.CrusadeRelic</option>
                        <option value="@CrusadeTraitTypes.BattleTrait">@CrusadeTraitTypes.BattleTrait</option>
                        <option value="@CrusadeTraitTypes.WeaponModification">@CrusadeTraitTypes.WeaponModification</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label small text-warning mb-0">Sub-category</label>
                    <input class="form-control form-control-sm bg-dark text-white border-secondary"
                           placeholder="e.g. Artificer"
                           @bind="_newTraitCategory" />
                </div>
                <div class="col-md-3">
                    <label class="form-label small text-warning mb-0">Name</label>
                    <input class="form-control form-control-sm bg-dark text-white border-secondary"
                           placeholder="e.g. Blade of the Eighth Sept"
                           @bind="_newTraitName" />
                </div>
                <div class="col-md-3">
                    <label class="form-label small text-warning mb-0">Effect</label>
                    <input class="form-control form-control-sm bg-dark text-white border-secondary"
                           placeholder="What the relic/trait does"
                           @bind="_newTraitEffect" />
                </div>
                <div class="col-md-2 d-grid">
                    <button class="btn btn-sm btn-warning" @onclick="AddCustomTrait"
                            disabled="@(string.IsNullOrWhiteSpace(_newTraitName) || string.IsNullOrWhiteSpace(_newTraitEffect))">
                        <i class="bi bi-plus-lg"></i> Add
                    </button>
                </div>
            </div>
            @if (_crusade.CustomTraits.Any())
            {
                <div class="mt-2">
                    @foreach (var ct in _crusade.CustomTraits)
                    {
                        var trait = ct;
                        <span class="badge bg-secondary me-1 mb-1" title="@trait.Effect">
                            <span class="text-warning">@trait.Type@(string.IsNullOrWhiteSpace(trait.Category) ? "" : $" / {trait.Category}"):</span>
                            @trait.Name
                            <button type="button" class="btn-close btn-close-white ms-1"
                                    style="font-size: 0.55rem; vertical-align: middle;"
                                    @onclick="() => RemoveCustomTrait(trait)" aria-label="Remove"></button>
                        </span>
                    }
                </div>
            }
        </details>

        @if (!_crusade.Units.Any())
        {
            <p class="text-center text-muted"><em>No units yet. Add one above.</em></p>
        }
        else
        {
            <div class="row g-3">
                @foreach (var unit in _crusade.Units)
                {
                    <div class="col-12 col-xl-6">
                        <div class="crusade-card">
                            <div class="crusade-card-header d-flex justify-content-between align-items-center">
                                <span>
                                    <i class="bi bi-person-badge me-2"></i>
                                    @(string.IsNullOrWhiteSpace(unit.UnitName) ? "Unnamed Unit" : unit.UnitName)
                                </span>
                                @{ var nextXp = RankCalculator.NextRankXp(unit.Xp, unit.IsCharacter, unit.LegendaryVeteransUsed); }
                                <span class="badge bg-warning text-dark crusade-rank-badge"
                                      title="@(nextXp is { } n ? $"Next rank at {n} XP" : "No further rank available")">
                                    @RankLabel(unit.Rank) · @(nextXp is { } nx ? $"{unit.Xp}/{nx} XP" : $"{unit.Xp} XP")
                                </span>
                            </div>
                            <div class="crusade-card-body">
                                <div class="row g-2">
                                    <div class="col-6">
                                        <label class="form-label small text-warning mb-0">Unit Name</label>
                                        <input class="form-control form-control-sm bg-dark text-white border-secondary"
                                               @bind="unit.UnitName" @bind:after="SaveAsync" />
                                    </div>
                                    <div class="col-6">
                                        <label class="form-label small text-warning mb-0">Datasheet</label>
                                        <input class="form-control form-control-sm bg-dark text-white border-secondary"
                                               @bind="unit.DatasheetName" @bind:after="SaveAsync" />
                                    </div>
                                    <div class="col-3">
                                        <label class="form-label small text-warning mb-0">Points</label>
                                        <input type="number" min="0" class="form-control form-control-sm bg-dark text-white border-secondary"
                                               @bind="unit.TotalPoints" @bind:after="SaveAsync" />
                                    </div>
                                    <div class="col-3">
                                        <label class="form-label small text-warning mb-0">XP</label>
                                        <input type="number" min="0" class="form-control form-control-sm bg-dark text-white border-secondary"
                                               @bind="unit.Xp" @bind:after="SaveAsync" />
                                    </div>
                                    <div class="col-3">
                                        <label class="form-label small text-warning mb-0">Destroyed</label>
                                        <input type="number" min="0" class="form-control form-control-sm bg-dark text-white border-secondary"
                                               @bind="unit.UnitsDestroyed" @bind:after="SaveAsync" />
                                    </div>
                                    <div class="col-3">
                                        <label class="form-label small text-warning mb-0">Crusade Pts</label>
                                        <input type="number" readonly title="Derived from honours and scars"
                                               class="form-control form-control-sm bg-dark text-white border-secondary"
                                               value="@unit.CrusadePoints" />
                                    </div>
                                    <div class="col-3">
                                        <label class="form-label small text-warning mb-0" title="Models in the unit at full strength (0 = unknown)">Models</label>
                                        <input type="number" min="0" class="form-control form-control-sm bg-dark text-white border-secondary"
                                               data-model-count="@unit.Id" @bind="unit.ModelCount" @bind:after="() => SaveStrengthAsync(unit)" />
                                    </div>
                                    <div class="col-3">
                                        <label class="form-label small text-warning mb-0" title="Wounds of each model (0 = unknown)">Wounds each</label>
                                        <input type="number" min="0" class="form-control form-control-sm bg-dark text-white border-secondary"
                                               data-wounds-per-model="@unit.Id" @bind="unit.WoundsPerModel" @bind:after="() => SaveStrengthAsync(unit)" />
                                    </div>
                                    <div class="col-3">
                                        <label class="form-label small text-warning mb-0" title="Models dead; they stay dead until a Requisition restores them">Models lost</label>
                                        <input type="number" min="0" class="form-control form-control-sm bg-dark text-white border-secondary"
                                               data-models-lost="@unit.Id" @bind="unit.ModelsLost" @bind:after="() => SaveStrengthAsync(unit)" />
                                    </div>
                                    <div class="col-3">
                                        <label class="form-label small text-warning mb-0" title="Wounds missing from the one damaged model">Wounds lost</label>
                                        <input type="number" min="0" class="form-control form-control-sm bg-dark text-white border-secondary"
                                               data-wounds-lost="@unit.Id" @bind="unit.WoundsLost" @bind:after="() => SaveStrengthAsync(unit)" />
                                    </div>
                                    <div class="col-12 small text-secondary">
                                        Battles @unit.BattlesPlayed · Survived @unit.BattlesSurvived
                                        @if (unit.IsDamaged) { <span class="badge bg-danger ms-1" data-strength="@unit.Id">@UnitStrength.Describe(unit)</span> }
                                        @if (unit.IsTitanic) { <span class="badge bg-secondary ms-1">TITANIC</span> }
                                        @if (!unit.XpEligible) { <span class="badge bg-secondary ms-1" title="EPIC HERO, FORTIFICATION and SWARM units never gain XP">No XP</span> }
                                    </div>

                                    <div class="col-6 d-flex align-items-end pb-1">
                                        <label class="form-check-label small">
                                            <input type="checkbox" class="form-check-input me-1"
                                                   @bind="unit.IsCharacter" @bind:after="SaveAsync" /> CHARACTER
                                        </label>
                                    </div>
                                    <div class="col-6 d-flex align-items-end pb-1">
                                        <label class="form-check-label small" title="Allows non-CHARACTER units to promote above Battle-hardened">
                                            <input type="checkbox" class="form-check-input me-1"
                                                   @bind="unit.LegendaryVeteransUsed" @bind:after="SaveAsync" /> Legendary Vet.
                                        </label>
                                    </div>

                                    <div class="col-12 mb-1">
                                        <button class="btn btn-sm btn-outline-secondary w-100"
                                                @onclick="() => ToggleUpgradePanel(unit.Id)">
                                            <i class="bi bi-sliders"></i>
                                            @(_upgradePanelOpen.GetValueOrDefault(unit.Id) ? "Hide" : "Manage") Honours &amp; Scars
                                        </button>
                                    </div>

                                    @if (_upgradePanelOpen.GetValueOrDefault(unit.Id))
                                    {
                                    <div class="col-12">
                                    <div class="card bg-dark border-secondary p-2 mb-1">
                                    <div class="row g-2">

                                    @{ var honourCap = unit.IsCharacter ? 6 : 3; }
                                    <div class="col-12">
                                        <label class="form-label small text-warning mb-0">
                                            Battle Honours
                                            <span class="text-muted">(@unit.BattleHonours.Count / @honourCap)</span>
                                            @if (unit.BattleHonours.Count > honourCap)
                                            {
                                                <span class="badge bg-warning text-dark ms-1" title="Exceeds rules cap (3 standard / 6 CHARACTER)">over cap</span>
                                            }
                                        </label>
                                        <div class="mb-1">
                                            @if (!unit.BattleHonours.Any())
                                            {
                                                <span class="text-muted small"><em>None</em></span>
                                            }
                                            @for (int i = 0; i < unit.BattleHonours.Count; i++)
                                            {
                                                var idx = i;
                                                var honour = unit.BattleHonours[idx];
                                                <span class="kw-tag-wrapper me-1 mb-1">
                                                    <span class="badge bg-success trait-badge"
                                                          @onclick="() => ShowTraitModal(honour)">
                                                        @honour.Name
                                                        <button type="button" class="btn-close btn-close-white ms-1"
                                                                style="font-size: 0.55rem; vertical-align: middle;"
                                                                @onclick="() => RemoveHonour(unit, idx)"
                                                                @onclick:stopPropagation="true"
                                                                aria-label="Remove"></button>
                                                    </span>
                                                    @if (!string.IsNullOrWhiteSpace(honour.Effect))
                                                    {
                                                        <div class="kw-tooltip">
                                                            <div class="kw-tooltip-title">@honour.Name</div>
                                                            <div class="kw-tooltip-body">@honour.Effect</div>
                                                        </div>
                                                    }
                                                </span>
                                            }
                                        </div>
                                        <HonourPicker Order="_crusade" Card="unit" RosterUnit="RosterUnitOf(unit)"
                                                      Picked="t => AddHonour(unit, t)" />
                                    </div>

                                    <div class="col-12">
                                        <label class="form-label small text-warning mb-0">
                                            Battle Scars
                                            <span class="text-muted">(@unit.BattleScars.Count / 3)</span>
                                            @if (unit.BattleScars.Count > 3)
                                            {
                                                <span class="badge bg-warning text-dark ms-1" title="Exceeds rules cap of 3">over cap</span>
                                            }
                                        </label>
                                        <div class="mb-1">
                                            @if (!unit.BattleScars.Any())
                                            {
                                                <span class="text-muted small"><em>None</em></span>
                                            }
                                            @for (int i = 0; i < unit.BattleScars.Count; i++)
                                            {
                                                var idx = i;
                                                var scar = unit.BattleScars[idx];
                                                <span class="kw-tag-wrapper me-1 mb-1">
                                                    <span class="badge bg-danger trait-badge"
                                                          @onclick="() => ShowTraitModal(scar)">
                                                        @scar.Name
                                                        <button type="button" class="btn-close btn-close-white ms-1"
                                                                style="font-size: 0.55rem; vertical-align: middle;"
                                                                @onclick="() => RemoveScar(unit, idx)"
                                                                @onclick:stopPropagation="true"
                                                                aria-label="Remove"></button>
                                                    </span>
                                                    @if (!string.IsNullOrWhiteSpace(scar.Effect))
                                                    {
                                                        <div class="kw-tooltip">
                                                            <div class="kw-tooltip-title">@scar.Name</div>
                                                            <div class="kw-tooltip-body">@scar.Effect</div>
                                                        </div>
                                                    }
                                                </span>
                                            }
                                        </div>
                                        <div class="row g-1">
                                            <div class="col-10">
                                                <select class="form-select form-select-sm bg-dark text-white border-secondary"
                                                        value="@GetScarChoice(unit.Id)"
                                                        @onchange="e => SetScarChoice(unit.Id, e.Value?.ToString() ?? string.Empty)">
                                                    <option value="">— Battle Scar —</option>
                                                    @foreach (var t in Traits.ByType(CrusadeTraitTypes.BattleScar))
                                                    {
                                                        <option value="@t.Name" title="@t.Effect">@t.Name</option>
                                                    }
                                                </select>
                                            </div>
                                            <div class="col-2 d-grid">
                                                <button class="btn btn-sm btn-outline-danger"
                                                        @onclick="() => AddScar(unit)"
                                                        disabled="@string.IsNullOrEmpty(GetScarChoice(unit.Id))">+</button>
                                            </div>
                                        </div>
                                    </div>

                                    </div> @* row g-2 *@
                                    </div> @* card *@
                                    </div> @* col-12 *@
                                    } @* _upgradePanelOpen *@

                                    <div class="col-12 mt-2 text-end">
                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => RemoveUnit(unit.Id)">
                                            <i class="bi bi-trash"></i> Remove unit
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    }
</div>

@if (_buying is { } buying && _crusade is not null)
{
    var affected = RequisitionRules.UnitsAffected(_crusade, buying);
    var restores = buying.Kind is RequisitionKind.RepairAll or RequisitionKind.ReinforceAll;
    var blocked = _buyCost is { } c ? RequisitionRules.CannotBuy(_crusade, c) : "Enter the cost in Requisition Points.";
    <div class="modal-backdrop fade show" style="cursor:pointer" @onclick="() => _buying = null"></div>
    <div class="modal fade show d-block" tabindex="-1" role="dialog" @onclick="() => _buying = null">
        <div class="modal-dialog modal-dialog-centered" @onclick:stopPropagation="true">
            <div class="modal-content bg-dark border-warning text-light" id="req-confirm">
                <div class="modal-header border-secondary">
                    <h5 class="modal-title text-warning"><i class="bi bi-box-seam me-2"></i>Buy @buying.Name?</h5>
                    <button type="button" class="btn-close btn-close-white" aria-label="Close" @onclick="() => _buying = null"></button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrWhiteSpace(buying.Effect))
                    {
                        <div class="small mb-3">@buying.Effect</div>
                    }
                    <div class="row g-2 align-items-end">
                        <div class="col-4">
                            <label class="form-label small text-warning mb-0" for="req-cost">Cost</label>
                            <input id="req-cost" type="number" min="0" class="form-control form-control-sm bg-dark text-white border-secondary"
                                   @bind:get="_buyCost?.ToString()" @bind:set="(string? v) => _buyCost = int.TryParse(v, out var n) ? n : null" />
                        </div>
                        <div class="col small text-secondary">
                            <div>@_crusade.RequisitionPoints RP available</div>
                            @if (restores && affected > 0)
                            {
                                <span>@affected unit@(affected == 1 ? "" : "s") will be restored.</span>
                            }
                            else if (buying.Kind == RequisitionKind.IncreaseSupplyLimit)
                            {
                                <span>Supply Limit @_crusade.SupplyLimit → @(_crusade.SupplyLimit + RequisitionRules.SupplyIncrease(buying, _buyCost ?? 0)).</span>
                            }
                            else if (buying.Kind == RequisitionKind.None)
                            {
                                <span>Text only: the points are spent and you apply the effect by hand.</span>
                            }
                        </div>
                    </div>
                    @if (blocked is not null)
                    {
                        <div class="small text-danger mt-2" id="req-warning"><i class="bi bi-exclamation-triangle me-1"></i>@blocked</div>
                    }
                    else if (restores && affected == 0)
                    {
                        <div class="small text-warning mt-2" id="req-warning"><i class="bi bi-exclamation-circle me-1"></i>No unit needs this right now. Buying it still spends the points.</div>
                    }
                    <div class="small text-secondary mt-3">A purchase cannot be undone here; correct mistakes with the +/− buttons and the card fields.</div>
                </div>
                <div class="modal-footer border-secondary">
                    <button class="btn btn-sm btn-outline-secondary" id="req-cancel" @onclick="() => _buying = null">Cancel</button>
                    <button class="btn btn-sm btn-success" id="req-confirm-buy" disabled="@(blocked is not null)" @onclick="BuyAsync">
                        <i class="bi bi-check2 me-1"></i>Buy
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@if (_showAddUnitModal && _crusade is not null)
{
    <div class="modal-backdrop fade show" style="cursor:pointer" @onclick="CloseAddUnitModal"></div>
    <div class="modal fade show d-block" tabindex="-1" role="dialog" @onclick="CloseAddUnitModal">
        <div class="modal-dialog modal-dialog-centered modal-lg" @onclick:stopPropagation="true">
            <div class="modal-content bg-dark border-warning text-light">
                <div class="modal-header border-secondary">
                    <h5 class="modal-title text-warning">
                        <i class="bi bi-person-plus me-2"></i>Select Unit — @_crusade.PlayerId.ToUpper() Roster
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseAddUnitModal"></button>
                </div>
                <div class="modal-body">
                    <input class="form-control form-control-sm bg-dark text-white border-secondary mb-2"
                           type="search" placeholder="Search units…" aria-label="Search units"
                           @bind="_unitSearch" @bind:event="oninput" />
                    <div class="wc-unit-grid">
                        @foreach (var u in FilteredUnits)
                        {
                            var selected = string.Equals(u.Name, _selectedUnitKey, StringComparison.OrdinalIgnoreCase);
                            var overBy = _crusade.SupplyUsed + u.Points - _crusade.SupplyLimit;
                            <div class="wc-tile @(selected ? "wc-tile-atk-on" : "")"
                                 title="@(overBy > 0 ? $"Adding this unit puts the Order of Battle {overBy} pts over its Supply Limit" : null)"
                                 data-unit="@u.Name" @onclick="() => PickUnit(u.Name)">
                                <div class="wc-tile-top">
                                    <i class="bi bi-person-fill wc-tile-ico"></i>
                                    <span class="wc-tile-name">@u.Name</span>
                                </div>
                                <div class="wc-tile-foot">
                                    @if (overBy > 0)
                                    {
                                        <span class="me-auto" style="font-size:0.7rem;color:#ff6b6b;"><i class="bi bi-exclamation-triangle"></i> +@overBy over</span>
                                    }
                                    <span style="font-size:0.75rem;color:#aaa;">@u.Points pts</span>
                                </div>
                            </div>
                        }
                    </div>
                    @if (!FilteredUnits.Any())
                    {
                        <p class="text-muted small mb-0"><em>No units match “@_unitSearch”.</em></p>
                    }
                </div>
                <div class="modal-footer border-secondary d-flex justify-content-between">
                    <label class="form-check-label">
                        <input type="checkbox" class="form-check-input me-1" @bind="_newUnitCharacter" /> CHARACTER
                    </label>
                    <div class="d-flex gap-2">
                        <button class="btn btn-outline-secondary" @onclick="CloseAddUnitModal">Cancel</button>
                        <button class="btn btn-warning" @onclick="AddUnit"
                                disabled="@string.IsNullOrEmpty(_selectedUnitKey)">
                            <i class="bi bi-plus-lg"></i> Confirm Add
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@if (_modalTrait != null)
{
    <div class="modal-backdrop fade show" style="cursor:pointer" @onclick="CloseTraitModal"></div>
    <div class="modal fade show d-block" tabindex="-1" role="dialog" @onclick="CloseTraitModal">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content bg-dark border-warning text-light" @onclick:stopPropagation="true">
                <div class="modal-header border-secondary">
                    <h5 class="modal-title text-warning">@_modalTrait.Name</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseTraitModal"></button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrWhiteSpace(_modalTrait.Type) || !string.IsNullOrWhiteSpace(_modalTrait.Category))
                    {
                        <p class="text-muted small mb-2">
                            @if (!string.IsNullOrWhiteSpace(_modalTrait.Type))
                            {
                                <span>@_modalTrait.Type</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(_modalTrait.Category) &&
                                 !string.Equals(_modalTrait.Category, _modalTrait.Type, StringComparison.OrdinalIgnoreCase))
                            {
                                <span> · @_modalTrait.Category</span>
                            }
                        </p>
                    }
                    @if (!string.IsNullOrWhiteSpace(_modalTrait.WeaponName))
                    {
                        <p class="small mb-2">
                            Applied to weapon: <strong class="text-warning">@_modalTrait.WeaponName</strong>
                        </p>
                    }
                    <p class="mb-0">
                        @(string.IsNullOrWhiteSpace(_modalTrait.Effect) ? "(no effect text recorded)" : _modalTrait.Effect)
                    </p>
                </div>
            </div>
        </div>
    </div>
}

