@page "/woundcalc"
@rendermode InteractiveServer
@using System.Text.RegularExpressions
@using Warhammer.Components.Calculator
@using Warhammer.Models
@using Warhammer.Models.Calculator
@using Warhammer.Models.Crusade
@using Warhammer.Services
@using Warhammer.Helpers
@inject StratagemService StratagemSvc
@inject WoundCalcStateService CalcState
@inject RosterLoadService RosterLoader
@inject CrusadeManagerService Crusades

<PageTitle>Wound Calculator</PageTitle>

<div class="ds-root">
    @if (!AllUnits.Any())
    {
        <div class="wc-loading">
            <div class="spinner-border text-warning" role="status"></div>
            <p class="mt-2 text-muted">Loading roster data...</p>
        </div>
    }
    else
    {
        <div class="ds-arena">

            <!-- ── ATTACKER ───────────────────────────── -->
            <DatasheetPanel Role="Attacker" Unit="SelectedAttacker" PickerOpen="_attackerPickerOpen"
                            BandClicked="() => _attackerPickerOpen = !_attackerPickerOpen"
                            DatasheetClicked="() => ShowUnitDetails(SelectedAttacker!)">
                <Picker>
                    <UnitPicker Units="AllUnits" PlayerFilter="@AttackerPlayerFilter" Selected="SelectedAttacker"
                                FilterChanged="SetAttackerFilter" Picked="PickAttacker" />
                </Picker>
                <Weapons>@AttackerWeaponsTable</Weapons>
                <Chips>
                    @if (SelectedWeapon != null)
                    {
                        <ModifierChips Chips="ChipsFor(ChipSide.Attacker)" Toggled="Toggled" />
                    }
                </Chips>
                <Body>
                    @StratagemList(AttackerStratagems)
                    @AbilityList(AttackerDetachmentRule, AttackerAbilities)
                </Body>
            </DatasheetPanel>

            <!-- ── ROLL SPINE ─────────────────────────── -->
            <RollSpine Hit="@EffectiveHitRoll" Wound="@EffectiveWoundRoll" Save="@FinalSaveRoll" Swap="SwapRoles" />

            <!-- ── DEFENDER ───────────────────────────── -->
            <DatasheetPanel Role="Defender" Unit="SelectedDefender" PickerOpen="_defenderPickerOpen"
                            Invuln="@(_invulnSave > 0 ? _invulnSave : null)"
                            StatOverrides="DefenderStatOverrides" StatMods="_defenderStatMods"
                            BandClicked="() => _defenderPickerOpen = !_defenderPickerOpen"
                            DatasheetClicked="() => ShowUnitDetails(SelectedDefender!)">
                <Picker>
                    <UnitPicker Units="AllUnits" PlayerFilter="@DefenderPlayerFilter" Selected="SelectedDefender"
                                FilterChanged="SetDefenderFilter" Picked="PickDefender" />
                </Picker>
                <Weapons>@DefenderWoundsRow</Weapons>
                <Chips>
                    <ModifierChips Chips="ChipsFor(ChipSide.Defender)" Toggled="Toggled" />
                    @InvulnOverride
                </Chips>
                <Body>
                    @StratagemList(DefenderStratagems)
                    @AbilityList(DefenderDetachmentRule, DefenderAbilities)
                </Body>
            </DatasheetPanel>

        </div>
    }
</div>

@if (SelectedStratagem != null)
{
    <div class="modal-backdrop fade show" style="cursor:pointer"></div>
    <div class="modal fade show d-block" tabindex="-1" role="dialog" @onclick="CloseModal">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content bg-dark border-warning text-light" @onclick:stopPropagation="true">
                <div class="modal-header border-secondary">
                    <h5 class="modal-title text-warning">@SelectedStratagem.Name</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseModal"></button>
                </div>
                <div class="modal-body">
                    <div class="d-flex justify-content-between mb-3">
                        <span class="badge bg-secondary">@SelectedStratagem.Type</span>
                        <span class="badge bg-danger">@SelectedStratagem.Cost CP</span>
                    </div>
                    <p><strong>WHEN:</strong> @SelectedStratagem.Turn</p>
                    <p><strong>PHASE:</strong> @SelectedStratagem.Phase</p>
                    <hr class="border-secondary" />
                    <div class="small">
                        @((MarkupString)SelectedStratagem.Description)
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@if (SelectedRule != null)
{
    <div class="modal-backdrop fade show" style="cursor:pointer" @onclick="CloseRuleModal"></div>
    <div class="modal fade show d-block" tabindex="-1" role="dialog" @onclick="CloseRuleModal">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content bg-dark border-secondary text-light" @onclick:stopPropagation="true">
                <div class="modal-header border-secondary">
                    <h5 class="modal-title" style="color:#c084fc">@SelectedRule.Name</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseRuleModal"></button>
                </div>
                <div class="modal-body small" style="line-height:1.6">
                    @((MarkupString)FormatText(SelectedRule.Description))
                </div>
            </div>
        </div>
    </div>
}

@if (ModalUnit != null)
{
    var mu         = ModalUnit.Unit;
    var muProfiles = GetAllProfilesRecursive(mu, "Unit").DistinctBy(p => p.Name).ToList();
    var muRanged   = GetAllProfilesRecursive(mu, "Ranged Weapons").DistinctBy(w => w.Name).ToList();
    var muMelee    = GetAllProfilesRecursive(mu, "Melee Weapons").DistinctBy(w => w.Name).ToList();
    var muAbils    = GetAbilities(mu);
    var muKws      = GetKeywords(mu);
    <div class="modal-backdrop fade show" style="cursor:pointer" @onclick="CloseUnitDetails"></div>
    <div class="modal fade show d-block" tabindex="-1" role="dialog" @onclick="CloseUnitDetails">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content wc-ds-modal" @onclick:stopPropagation="true">

                <div class="wc-ds-header">
                    <h5 class="wc-ds-title">@mu.Name</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseUnitDetails"></button>
                </div>

                <div class="modal-body wc-ds-body">

                    @foreach (var profile in muProfiles)
                    {
                        @if (muProfiles.Count > 1)
                        {
                            <div class="ds-profile-name">@profile.Name</div>
                        }
                        <div class="ds-stats-strip">
                            @if (profile.Characteristics != null)
                            {
                                @foreach (var stat in profile.Characteristics)
                                {
                                    <div class="ds-stat-cell">
                                        <span class="ds-stat-label">@stat.Name</span>
                                        <span class="ds-stat-value">@stat.Value</span>
                                    </div>
                                }
                            }
                        </div>
                    }

                    @if (muRanged.Any())
                    {
                        <WeaponTable Weapons="muRanged" SectionTitle="Ranged Weapons" SectionIcon="bi-crosshair2" SkillHeader="BS" />
                    }

                    @if (muMelee.Any())
                    {
                        <WeaponTable Weapons="muMelee" SectionTitle="Melee Weapons" SectionIcon="bi-hammer" SkillHeader="WS" AddTopMargin="true" />
                    }

                    @if (muAbils.Any())
                    {
                        <div class="section-header mt-2">Abilities & Rules</div>
                        <div class="abilities-box" style="padding: 10px 15px;">
                            @foreach (var rule in muAbils)
                            {
                                <div class="ability-row">
                                    <span class="ability-name">@rule.Name:</span>
                                    <span class="ability-desc">@FormatText(rule.Description)</span>
                                </div>
                            }
                        </div>
                    }

                    @if (muKws.Any())
                    {
                        <div class="datasheet-footer">
                            <span class="footer-label">KEYWORDS:</span>
                            <div class="keyword-list">
                                @foreach (var k in muKws)
                                {
                                    <span class="kw">@k</span>
                                }
                            </div>
                        </div>
                    }

                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<UnitEntry> AllUnits = new();
    private List<Profile> AttackerWeapons = new();

    private string? AttackerPlayerFilter;
    private string? DefenderPlayerFilter;
    private bool _attackerPickerOpen;
    private bool _defenderPickerOpen;

    private UnitEntry? SelectedAttacker;
    private UnitEntry? SelectedDefender;
    private string? _selectedWeaponName;
    private Profile? SelectedWeapon;

    private int? WeaponStrength;
    private int? WeaponAp;
    private string? HitRoll;
    private int? DefenderToughness;
    private int? DefenderSave;
    private List<(int? Count, string W)>? DefenderWounds;
    private string? WeaponAttacks;
    private string? WeaponKeywords;
    private List<KeywordToken> SelectedWeaponKeywords = new();

    // Situation Toggles and manual modifiers; every automatic modifier is derived by AttackModifierEngine.
    private Situation _situation = Situation.None;
    private int  _invulnSave;       // 0 = None, else 3/4/5/6 (defaults to the datasheet value)
    private int? _autoInvulnSave;   // detected from unit profile

    // Engine output
    private IReadOnlyList<ModChip> _chips = [];
    private string? EffectiveHitRoll;
    private string? EffectiveWoundRoll;
    private string? FinalSaveRoll;

    // Per-stat list of crusade traits that contributed a modifier (for the
    // gold asterisk + hover tooltip). Cleared and re-populated every time a
    // weapon or defender unit is (re-)selected.
    private readonly Dictionary<string, List<string>> _attackerStatMods = new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<string, List<string>> _defenderStatMods = new(StringComparer.OrdinalIgnoreCase);

    private List<string>? StatModInfo(string stat, bool isDefender)
    {
        var mods = isDefender ? _defenderStatMods : _attackerStatMods;
        return mods.TryGetValue(stat, out var list) && list.Count > 0 ? list : null;
    }

    private List<StratagemModelWithDetachment> AttackerStratagems = new();
    private List<StratagemModelWithDetachment> DefenderStratagems = new();
    private StratagemModelWithDetachment? SelectedStratagem;
    private UnitEntry? ModalUnit;
    private List<Rule> AttackerAbilities = new();
    private List<Rule> DefenderAbilities = new();
    private Rule? SelectedRule;
    private Dictionary<string, Rule> DetachmentRules = new();
    private Rule? AttackerDetachmentRule;
    private Rule? DefenderDetachmentRule;

    protected override async Task OnInitializedAsync()
    {
        await StratagemSvc.EnsureLoadedAsync();

        var playerIds = await RosterLoader.GetActivePlayerIdsAsync();
        int playerIndex = 1;
        foreach (var playerId in playerIds)
        {
            var roster = await RosterLoader.LoadRosterAsync(playerId);
            var force = roster?.Roster?.Forces?.FirstOrDefault();
            if (force == null) { playerIndex++; continue; }

            var detachmentSel = force.Selections
                .FirstOrDefault(s => s.Name == "Detachment")
                ?.Selections?.FirstOrDefault();
            var detachment     = detachmentSel?.Name ?? "";
            var detachmentRule = detachmentSel?.Rules?.FirstOrDefault();
            if (!string.IsNullOrEmpty(detachment) && detachmentRule != null)
                DetachmentRules[detachment] = detachmentRule;

            foreach (var unit in RosterLoadService.GetPlayableUnits(roster).DistinctBy(u => u.Name))
            {
                AllUnits.Add(new UnitEntry(
                    $"{playerId}_{unit.Name}",
                    unit.Name,
                    playerId,
                    playerIndex,
                    unit,
                    detachment
                ));
            }

            playerIndex++;
        }

        await AddCrusadeUnitsAsync();
        RestoreFromState();
    }

    // Crusade Cards (SQLite) become extra "pc" entries carrying their honour and scar modifiers.
    private async Task AddCrusadeUnitsAsync()
    {
        await Crusades.LoadAllCrusadesAsync();

        foreach (var crusade in Crusades.Crusades)
        {
            if (string.IsNullOrEmpty(crusade.PlayerId)) continue;

            var roster = await RosterLoader.LoadRosterAsync(crusade.PlayerId);
            if (roster == null) continue;

            var selectionsByName = RosterLoadService.GetPlayableUnits(roster)
                .DistinctBy(u => u.Name)
                .ToDictionary(u => u.Name, StringComparer.OrdinalIgnoreCase);

            foreach (var card in crusade.Units)
            {
                if (string.IsNullOrEmpty(card.DatasheetName)) continue;
                if (!selectionsByName.TryGetValue(card.DatasheetName, out var selection)) continue;

                var label = string.IsNullOrWhiteSpace(card.UnitName) ? card.DatasheetName : card.UnitName;
                AllUnits.Add(new UnitEntry(
                    Key:            $"pc_{crusade.Id}_{card.Id}",
                    Label:          label,
                    PlayerId:       "pc",
                    PlayerIndex:    0,
                    Unit:           selection,
                    DetachmentName: crusade.DetachmentName,
                    CrusadeData:    card
                ));
            }
        }
    }

    private void RestoreFromState()
    {
        AttackerPlayerFilter = CalcState.AttackerFilter;
        DefenderPlayerFilter = CalcState.DefenderFilter;

        if (SelectedAttacker == null && !string.IsNullOrEmpty(CalcState.AttackerUnitKey))
        {
            var atk = AllUnits.FirstOrDefault(u => u.Key == CalcState.AttackerUnitKey);
            if (atk != null)
            {
                var savedWeapon = CalcState.WeaponName;
                SelectAttackerUnit(atk);
                if (!string.IsNullOrEmpty(savedWeapon))
                {
                    var w = AttackerWeapons.FirstOrDefault(x => x.Name == savedWeapon);
                    if (w != null) SelectWeapon(w);
                }
            }
        }

        if (SelectedDefender == null && !string.IsNullOrEmpty(CalcState.DefenderUnitKey))
        {
            var def = AllUnits.FirstOrDefault(u => u.Key == CalcState.DefenderUnitKey);
            if (def != null) SelectDefenderUnit(def);
        }
    }

    private void SetAttackerFilter(string? playerId)
    {
        AttackerPlayerFilter = playerId;
        if (SelectedAttacker != null && playerId != null && SelectedAttacker.PlayerId != playerId)
            ClearAttacker();
        CalcState.AttackerFilter = AttackerPlayerFilter;
    }

    private void SetDefenderFilter(string? playerId)
    {
        DefenderPlayerFilter = playerId;
        if (SelectedDefender != null && playerId != null && SelectedDefender.PlayerId != playerId)
            ClearDefender();
        CalcState.DefenderFilter = DefenderPlayerFilter;
    }

    private void PickAttacker(UnitEntry entry)
    {
        _attackerPickerOpen = false;
        if (SelectedAttacker?.Key != entry.Key) SelectAttackerUnit(entry);
    }

    private void PickDefender(UnitEntry entry)
    {
        _defenderPickerOpen = false;
        if (SelectedDefender?.Key != entry.Key) SelectDefenderUnit(entry);
    }

    private void SelectAttackerUnit(UnitEntry entry)
    {
        SelectedAttacker = entry;
        ResetWeaponFields();
        _situation = _situation with
        {
            PlusHit = false, PlusWound = false, Stationary = false, Charged = false,
            NotVisible = false, InEngagementRange = false
        };
        AttackerWeapons = GetAllWeapons(entry.Unit);
        AttackerStratagems = StratagemsFor(entry, "your");
        AttackerAbilities = GetAbilities(entry.Unit);
        AttackerDetachmentRule = DetachmentRules.TryGetValue(entry.DetachmentName, out var adr) ? adr : null;
        CalcState.AttackerUnitKey = entry.Key;
        CalcState.WeaponName = null;
        Recalculate();
    }

    private List<StratagemModelWithDetachment> StratagemsFor(UnitEntry entry, string turn) =>
        StratagemSvc.GetStratagemsForUnit(entry.Unit.Name, entry.DetachmentName)
            .Where(s => s.Turn.Contains(turn, StringComparison.OrdinalIgnoreCase))
            .OrderBy(s => s.Phase).ThenBy(s => s.Name)
            .ToList();

    private void ResetWeaponFields()
    {
        _selectedWeaponName = null;
        SelectedWeapon = null;
        WeaponStrength = null;
        WeaponAp = null;
        HitRoll = null;
        WeaponAttacks = null;
        WeaponKeywords = null;
        SelectedWeaponKeywords = new();
        _attackerStatMods.Clear();
    }

    private void SelectWeapon(Profile w)
    {
        if (_selectedWeaponName == w.Name) { ClearWeapon(); return; }

        _selectedWeaponName = w.Name;
        SelectedWeapon = w;

        var sVal = GetChar(w, "S");
        WeaponStrength = int.TryParse(sVal, out var s) ? s : null;

        var apVal = GetChar(w, "AP");
        WeaponAp = int.TryParse(apVal, out var ap) ? ap : null;

        var skillStat = w.TypeName == "Ranged Weapons" ? "BS" : "WS";
        var skillRaw  = GetChar(w, skillStat);
        HitRoll = skillRaw is "N/A" or "-" ? "AUTO" : skillRaw;

        WeaponAttacks  = GetChar(w, "A");
        WeaponKeywords = GetChar(w, "Keywords");
        SelectedWeaponKeywords = RosterHelper.ParseWeaponKeywords(WeaponKeywords ?? "");
        CalcState.WeaponName = _selectedWeaponName;
        ApplyAttackerCrusadeMods();

        // Remained stationary, target not visible and engagement range only matter for ranged attacks.
        if (!SelectedWeaponIsRanged)
            _situation = _situation with { Stationary = false, NotVisible = false, InEngagementRange = false };
        Recalculate();
    }

    // Honour/scar machine modifiers are applied AFTER base weapon stats are read,
    // so the base values come from the roster profile and the deltas come from
    // the CrusadeUnitCard. Per-weapon honours (WeaponName / WeaponScope) are
    // filtered against the currently-selected weapon — see TraitAppliesToWeapon.
    private void ApplyAttackerCrusadeMods()
    {
        _attackerStatMods.Clear();
        if (SelectedAttacker?.CrusadeData == null) return;

        var traits = SelectedAttacker.CrusadeData.BattleHonours
            .Concat(SelectedAttacker.CrusadeData.BattleScars);

        foreach (var t in traits)
        {
            var m = t.Modifier;
            if (m == null) continue;
            if (!TraitAppliesToWeapon(t)) continue;

            if (!string.IsNullOrWhiteSpace(m.Keyword))
            {
                SelectedWeaponKeywords.AddRange(RosterHelper.ParseWeaponKeywords(m.Keyword));
                Track(_attackerStatMods, "Keyword", t.Name);
            }

            switch (m.Stat?.ToUpperInvariant())
            {
                case "S":
                    if (m.Value.HasValue) { WeaponStrength = (WeaponStrength ?? 0) + m.Value.Value; Track(_attackerStatMods, "S", t.Name); }
                    else if (m.SetTo.HasValue) { WeaponStrength = Math.Max(WeaponStrength ?? 0, m.SetTo.Value); Track(_attackerStatMods, "S", t.Name); }
                    break;
                case "AP":
                    if (m.Value.HasValue) { WeaponAp = (WeaponAp ?? 0) + m.Value.Value; Track(_attackerStatMods, "AP", t.Name); }
                    break;
                case "BS":
                case "WS":
                    if (m.Value.HasValue) { HitRoll = AdjustPlusRoll(HitRoll, m.Value.Value); Track(_attackerStatMods, "Hit", t.Name); }
                    break;
                case "A":
                    if (m.Value.HasValue) { WeaponAttacks = AdjustNumericString(WeaponAttacks, m.Value.Value); Track(_attackerStatMods, "A", t.Name); }
                    break;
                // "D" / "Move" / "OC" — not in calc input. Tooltip still tells the story.
            }
        }
    }

    private void ApplyDefenderCrusadeMods()
    {
        _defenderStatMods.Clear();
        if (SelectedDefender?.CrusadeData == null) return;

        var traits = SelectedDefender.CrusadeData.BattleHonours
            .Concat(SelectedDefender.CrusadeData.BattleScars);

        foreach (var t in traits)
        {
            var m = t.Modifier;
            if (m == null) continue;

            switch (m.Stat?.ToUpperInvariant())
            {
                case "T":
                    if (m.Value.HasValue) { DefenderToughness = (DefenderToughness ?? 0) + m.Value.Value; Track(_defenderStatMods, "T", t.Name); }
                    break;
                case "SV":
                    if (m.SetTo.HasValue)
                    {
                        DefenderSave = DefenderSave.HasValue ? Math.Min(DefenderSave.Value, m.SetTo.Value) : m.SetTo;
                        Track(_defenderStatMods, "Sv", t.Name);
                    }
                    else if (m.Value.HasValue)
                    {
                        DefenderSave = (DefenderSave ?? 0) + m.Value.Value;
                        Track(_defenderStatMods, "Sv", t.Name);
                    }
                    break;
                case "INVULN":
                    if (m.SetTo.HasValue)
                    {
                        _invulnSave = _invulnSave == 0 ? m.SetTo.Value : Math.Min(_invulnSave, m.SetTo.Value);
                        Track(_defenderStatMods, "Invuln", t.Name);
                    }
                    break;
            }
        }
    }

    private static void Track(Dictionary<string, List<string>> mods, string stat, string traitName)
    {
        if (!mods.TryGetValue(stat, out var list))
        {
            list = new();
            mods[stat] = list;
        }
        list.Add(traitName);
    }

    // True when the trait's weapon-scope matches whatever weapon is currently picked.
    //   WeaponName set  → strict match against the currently-selected weapon name
    //   WeaponScope = "ranged" / "melee" → match the current weapon's TypeName
    //   Both null       → no weapon constraint (unit-wide / legacy applied trait)
    private bool TraitAppliesToWeapon(AppliedTrait t)
    {
        if (!string.IsNullOrEmpty(t.WeaponName))
        {
            return string.Equals(t.WeaponName, _selectedWeaponName, StringComparison.OrdinalIgnoreCase);
        }

        var scope = t.WeaponScope;
        if (scope is "ranged" or "weapon-ranged")
            return SelectedWeapon?.TypeName == "Ranged Weapons";
        if (scope is "melee" or "weapon-melee")
            return SelectedWeapon?.TypeName == "Melee Weapons";

        // "weapon" scope without a chosen WeaponName means the trait pre-dates the
        // weapon-targeting UI — apply to all weapons to preserve legacy behaviour.
        return true;
    }

    // "3+" → adjusted by delta, clamped to 2..6. Untouched if "AUTO" or unparseable.
    private static string? AdjustPlusRoll(string? roll, int delta)
    {
        if (string.IsNullOrEmpty(roll) || roll == "AUTO") return roll;
        if (!int.TryParse(roll.TrimEnd('+'), out var n)) return roll;
        return $"{Math.Clamp(n + delta, 2, 6)}+";
    }

    private static string? AdjustNumericString(string? raw, int delta)
    {
        if (string.IsNullOrEmpty(raw) || !int.TryParse(raw, out var n)) return raw;
        return (n + delta).ToString();
    }

    private void SelectDefenderUnit(UnitEntry entry)
    {
        SelectedDefender = entry;
        _situation = _situation with { Cover = false, MinusHit = false, MinusWound = false, ReduceAp = false };
        LoadDefenderStats(entry);

        DefenderStratagems = StratagemsFor(entry, "opponent");
        DefenderAbilities = GetAbilities(entry.Unit);
        DefenderDetachmentRule = DetachmentRules.TryGetValue(entry.DetachmentName, out var ddr) ? ddr : null;

        CalcState.DefenderUnitKey = entry.Key;
        ApplyDefenderCrusadeMods();
        Recalculate();
    }

    private void LoadDefenderStats(UnitEntry? entry)
    {
        if (entry == null)
        {
            DefenderToughness = null;
            DefenderSave      = null;
            DefenderWounds    = null;
            _autoInvulnSave   = null;
            _invulnSave       = 0;
            return;
        }
        var unitProfile = GetAllProfilesRecursive(entry.Unit, "Unit").FirstOrDefault();
        var tVal  = GetChar(unitProfile, "T");
        var svVal = GetChar(unitProfile, "SV");
        DefenderToughness = int.TryParse(tVal, out var t) ? t : null;
        DefenderSave      = int.TryParse(svVal.TrimEnd('+'), out var sv) ? sv : null;
        DefenderWounds    = BuildDefenderWounds(entry.Unit);
        _autoInvulnSave   = ParseInvulnSave(entry.Unit);
        _invulnSave       = _autoInvulnSave ?? 0;
    }

    private void ClearAttacker()
    {
        SelectedAttacker = null;
        AttackerWeapons = new();
        AttackerStratagems = new();
        AttackerAbilities = new();
        AttackerDetachmentRule = null;
        CalcState.AttackerUnitKey = null;
        ClearWeapon();
    }

    private void ClearWeapon()
    {
        ResetWeaponFields();
        _situation = _situation with { InEngagementRange = false };
        CalcState.WeaponName = null;
        Recalculate();
    }

    private void ClearDefender()
    {
        SelectedDefender = null;
        LoadDefenderStats(null);
        _situation = _situation with { Cover = false, MinusHit = false, MinusWound = false, ReduceAp = false };
        DefenderStratagems = new();
        DefenderAbilities = new();
        DefenderDetachmentRule = null;
        _defenderStatMods.Clear();
        CalcState.DefenderUnitKey = null;
        Recalculate();
    }

    private void SwapRoles()
    {
        if (SelectedAttacker == null && SelectedDefender == null) return;

        var oldAttacker = SelectedAttacker;
        var oldDefender = SelectedDefender;
        (AttackerPlayerFilter, DefenderPlayerFilter) = (DefenderPlayerFilter, AttackerPlayerFilter);

        // Old Defender → new Attacker (weapon selection reset; the user picks one).
        SelectedAttacker = oldDefender;
        ResetWeaponFields();
        _situation = Situation.None;
        AttackerWeapons = oldDefender != null ? GetAllWeapons(oldDefender.Unit) : new();

        // Old Attacker → new Defender (re-derive T, Sv, invuln, wounds).
        SelectedDefender = oldAttacker;
        LoadDefenderStats(oldAttacker);

        AttackerStratagems = SelectedAttacker != null ? StratagemsFor(SelectedAttacker, "your") : new();
        AttackerAbilities = SelectedAttacker != null ? GetAbilities(SelectedAttacker.Unit) : new();
        AttackerDetachmentRule = SelectedAttacker != null && DetachmentRules.TryGetValue(SelectedAttacker.DetachmentName, out var sadr) ? sadr : null;

        DefenderStratagems = SelectedDefender != null ? StratagemsFor(SelectedDefender, "opponent") : new();
        DefenderAbilities = SelectedDefender != null ? GetAbilities(SelectedDefender.Unit) : new();
        DefenderDetachmentRule = SelectedDefender != null && DetachmentRules.TryGetValue(SelectedDefender.DetachmentName, out var sddr) ? sddr : null;

        CalcState.AttackerFilter = AttackerPlayerFilter;
        CalcState.DefenderFilter = DefenderPlayerFilter;
        CalcState.AttackerUnitKey = SelectedAttacker?.Key;
        CalcState.DefenderUnitKey = SelectedDefender?.Key;
        CalcState.WeaponName = null;

        // Old attacker (now defender) keeps its crusade-based defender mods.
        ApplyDefenderCrusadeMods();
        Recalculate();
    }

    // ── Modifier engine ────────────────────────────────────────────────────
    private AttackFacts BuildFacts() => new(
        Skill:              HitRoll,
        Strength:           WeaponStrength,
        Ap:                 WeaponAp,
        // Before a weapon is picked, defender chips are shown as for a ranged attack.
        IsRanged:           SelectedWeapon == null || SelectedWeaponIsRanged,
        WeaponKeywords:     SelectedWeaponKeywords.Select(k => k.Raw).ToList(),
        AttackerKeywords:   SelectedAttacker != null ? GetKeywords(SelectedAttacker.Unit) : [],
        DefenderKeywords:   SelectedDefender != null ? GetKeywords(SelectedDefender.Unit) : [],
        DefenderHasStealth: SelectedDefender != null && RosterHelper.GetAbilities(SelectedDefender.Unit)
                                .Any(r => r.Name.StartsWith("Stealth", StringComparison.OrdinalIgnoreCase)),
        DefenderToughness:  DefenderToughness,
        DefenderSave:       DefenderSave,
        DefenderInvuln:     _invulnSave > 0 ? _invulnSave : null);

    private void Recalculate()
    {
        var resolution = AttackModifierEngine.Resolve(BuildFacts(), _situation);
        var result = WoundCalculationService.Calculate(resolution.Input);

        _chips = resolution.Chips;
        EffectiveHitRoll = SelectedWeapon != null ? result.EffectiveHitRoll : null;
        FinalSaveRoll = result.FinalSaveRoll;

        // Anti-X: a critical wound on N+ means the roll needed is never worse than N+.
        EffectiveWoundRoll = result.EffectiveWoundRoll;
        if (resolution.AntiThreshold is int anti && EffectiveWoundRoll is not null &&
            (EffectiveWoundRoll == "N/A" || WoundCalculationService.ParseRollNum(EffectiveWoundRoll) > anti))
            EffectiveWoundRoll = $"{anti}+";
    }

    private IReadOnlyList<ModChip> ChipsFor(ChipSide side) => _chips.Where(c => c.Side == side).ToList();

    // A chip tap flips the Situation Toggle or manual modifier it stands for.
    private void Toggled(string key)
    {
        var s = _situation;
        _situation = key switch
        {
            "heavy"      => s with { Stationary = !s.Stationary },
            "lance"      => s with { Charged = !s.Charged },
            "indirect"   => s with { NotVisible = !s.NotVisible },
            "bgnt"       => s with { InEngagementRange = !s.InEngagementRange },
            "cover"      => s with { Cover = !s.Cover },
            "plusHit"    => s with { PlusHit = !s.PlusHit },
            "plusWound"  => s with { PlusWound = !s.PlusWound },
            "minusHit"   => s with { MinusHit = !s.MinusHit },
            "minusWound" => s with { MinusWound = !s.MinusWound },
            "reduceAp"   => s with { ReduceAp = !s.ReduceAp },
            _ => s
        };
        Recalculate();
    }

    private void SetInvuln(int value) { _invulnSave = value; Recalculate(); }

    private bool SelectedWeaponIsRanged => SelectedWeapon?.TypeName == "Ranged Weapons";

    private IReadOnlyDictionary<string, string>? DefenderStatOverrides
    {
        get
        {
            if (SelectedDefender == null) return null;
            var d = new Dictionary<string, string>();
            if (DefenderToughness is int t) d["T"] = t.ToString();
            if (DefenderSave is int sv) d["SV"] = $"{sv}+";
            if (DefenderWounds is { Count: > 1 })
                d["W"] = string.Join(", ", DefenderWounds.Select(w => $"{w.Count}|{w.W}"));
            return d;
        }
    }

    // ── Render fragments ───────────────────────────────────────────────────
    private RenderFragment AttackerWeaponsTable => __builder =>
    {
        if (!AttackerWeapons.Any()) return;
        <div class="ds-weapons">
            @foreach (var group in AttackerWeapons.GroupBy(w => w.TypeName == "Ranged Weapons"))
            {
                <div class="ds-wgroup">
                    <div class="ds-whead">
                        <span class="ds-wtitle">@(group.Key ? "Ranged weapons" : "Melee weapons")</span>
                        <span>Range</span><span>A</span><span>@(group.Key ? "BS" : "WS")</span><span>S</span><span>AP</span><span>D</span>
                    </div>
                    @foreach (var w in group)
                    {
                        var weapon = w;
                        var on = _selectedWeaponName == w.Name;
                        <button type="button" class="ds-wrow @(on ? "ds-wrow-on" : "")" data-weapon="@w.Name"
                                aria-pressed="@(on ? "true" : "false")" @onclick="() => SelectWeapon(weapon)">
                            <span class="ds-wname">
                                @GetCleanWeaponName(w.Name)
                                @if (!on && GetChar(w, "Keywords") is { Length: > 0 } kws && kws != "-")
                                {
                                    <small>@kws</small>
                                }
                            </span>
                            <span>@GetChar(w, "Range")</span>
                            @StatCell(on ? WeaponAttacks : GetChar(w, "A"), on ? StatModInfo("A", false) : null)
                            @StatCell(on ? HitRoll : GetChar(w, group.Key ? "BS" : "WS"), on ? StatModInfo("Hit", false) : null)
                            @StatCell(on ? WeaponStrength?.ToString() : GetChar(w, "S"), on ? StatModInfo("S", false) : null)
                            @StatCell(on ? WeaponAp?.ToString() : GetChar(w, "AP"), on ? StatModInfo("AP", false) : null)
                            <span>@GetChar(w, "D")</span>
                        </button>
                    }
                </div>
            }
            @if (SelectedWeapon != null && SelectedWeaponKeywords.Any())
            {
                <div class="ds-kw-row">
                    @foreach (var kw in SelectedWeaponKeywords)
                    {
                        @if (kw.Definition != null)
                        {
                            <span class="kw-tag-wrapper">
                                <span class="ds-kw">@kw.Raw</span>
                                <div class="kw-tooltip">
                                    <div class="kw-tooltip-title">@kw.Raw</div>
                                    <div class="kw-tooltip-body">@kw.Definition</div>
                                </div>
                            </span>
                        }
                        else
                        {
                            <span class="ds-kw">@kw.Raw</span>
                        }
                    }
                    @if (StatModInfo("Keyword", false) is { } kwMods)
                    {
                        <span class="ds-kw ds-kw-crusade" title="Crusade: @string.Join(", ", kwMods)">* Crusade</span>
                    }
                </div>
            }
        </div>
    };

    // A weapon stat cell; a Crusade-modified value gets the gold asterisk and names the honours on hover.
    private static RenderFragment StatCell(string? value, List<string>? mods) => __builder =>
    {
        if (mods is { Count: > 0 })
        {
            <span class="ds-wcrusade" title="Crusade: @string.Join(", ", mods)">@value<sup>*</sup></span>
        }
        else
        {
            <span>@value</span>
        }
    };

    private RenderFragment DefenderWoundsRow => __builder =>
    {
        if (DefenderWounds is not { Count: > 1 }) return;
        <div class="ds-wounds" title="Mixed unit: count|wounds per model">
            Wounds per model:
            @foreach (var part in DefenderWounds)
            {
                <span class="ds-wounds-part"><strong>@part.Count</strong>×@part.W W</span>
            }
        </div>
    };

    private RenderFragment InvulnOverride => __builder =>
    {
        if (SelectedDefender == null) return;
        <div class="ds-invuln" role="group" aria-label="Invulnerable save">
            <span class="ds-section-label">
                Invuln
                @if (_autoInvulnSave.HasValue)
                {
                    <em>datasheet @(_autoInvulnSave)+</em>
                }
            </span>
            <button type="button" class="ds-filter-btn @(_invulnSave == 0 ? "ds-filter-on" : "")" @onclick="() => SetInvuln(0)">None</button>
            @foreach (var inv in new[] { 3, 4, 5, 6 })
            {
                var v = inv;
                <button type="button" class="ds-filter-btn @(_invulnSave == v ? "ds-filter-on" : "")" data-invuln="@v"
                        @onclick="() => SetInvuln(v)">@(v)+</button>
            }
        </div>
    };

    private RenderFragment StratagemList(List<StratagemModelWithDetachment> stratagems) => __builder =>
    {
        if (!stratagems.Any()) return;
        <div class="ds-section">
            <div class="ds-section-label">Stratagems</div>
            <div class="strat-list">
                @foreach (var s in stratagems)
                {
                    var strat = s;
                    <button type="button" class="strat-badge @StratClass(strat)" @onclick="() => ShowStratagem(strat)">
                        <span class="strat-name-text">@strat.Name</span>
                        <span class="cp-badge">@strat.Cost CP</span>
                    </button>
                }
            </div>
        </div>
    };

    private RenderFragment AbilityList(Rule? detachmentRule, List<Rule> abilities) => __builder =>
    {
        if (detachmentRule == null && !abilities.Any()) return;
        <div class="ds-section">
            <div class="ds-section-label"><i class="bi bi-lightning-fill me-1"></i>Abilities</div>
            <div class="ds-abilities">
                @if (detachmentRule != null)
                {
                    var dr = detachmentRule;
                    <span class="kw-tag-wrapper">
                        <button type="button" class="ds-ability ds-ability-detachment" @onclick="() => ShowRule(dr)">[DETACHMENT] @dr.Name</button>
                        <div class="kw-tooltip">
                            <div class="kw-tooltip-title">@dr.Name</div>
                            <div class="kw-tooltip-body">@((MarkupString)FormatText(dr.Description))</div>
                        </div>
                    </span>
                }
                @foreach (var rule in abilities)
                {
                    var r = rule;
                    <span class="kw-tag-wrapper">
                        <button type="button" class="ds-ability" @onclick="() => ShowRule(r)">@r.Name</button>
                        <div class="kw-tooltip">
                            <div class="kw-tooltip-title">@r.Name</div>
                            <div class="kw-tooltip-body">@((MarkupString)FormatText(r.Description))</div>
                        </div>
                    </span>
                }
            </div>
        </div>
    };

    // ── Datasheet helpers ──────────────────────────────────────────────────
    private static string GetCleanWeaponName(string raw) => RosterHelper.GetCleanWeaponName(raw);

    private int? ParseInvulnSave(Selection unit)
    {
        // Look for a profile named "Invulnerable Save" (or containing "Invulnerable")
        var abilityProfiles = GetAllProfilesRecursive(unit, "Abilities");
        foreach (var p in abilityProfiles)
        {
            if (!p.Name.Contains("Invulnerable", StringComparison.OrdinalIgnoreCase)) continue;
            var desc = p.Characteristics?.FirstOrDefault(c => c.Name == "Description")?.Value ?? p.Name;
            var m = Regex.Match(desc, @"\b([2-6])\+");
            if (m.Success && int.TryParse(m.Groups[1].Value, out int inv)) return inv;
        }

        // Fall back: scan all rules text for "invulnerable ... X+"
        var rules = RosterHelper.CollectRules(unit);
        foreach (var r in rules)
        {
            var text = r.Name + " " + r.Description;
            if (!text.Contains("invulnerable", StringComparison.OrdinalIgnoreCase)) continue;
            var m = Regex.Match(text, @"\b([2-6])\+");
            if (m.Success && int.TryParse(m.Groups[1].Value, out int inv)) return inv;
        }
        return null;
    }

    private List<Profile> GetAllWeapons(Selection unit)
    {
        var ranged = GetAllProfilesRecursive(unit, "Ranged Weapons");
        var melee  = GetAllProfilesRecursive(unit, "Melee Weapons");
        return ranged.Concat(melee).DistinctBy(w => w.Name).ToList();
    }

    private List<Profile> GetAllProfilesRecursive(Selection? current, string typeName) => RosterHelper.GetAllProfilesRecursive(current, typeName);

    private static void CollectUnitModels(Selection? sel, List<(int Number, Profile Profile)> sink)
    {
        if (sel == null) return;
        if (sel.Profiles != null)
        {
            foreach (var p in sel.Profiles.Where(p => p.TypeName == "Unit"))
                sink.Add((Math.Max(1, sel.Number), p));
        }
        if (sel.Selections != null)
            foreach (var child in sel.Selections)
                CollectUnitModels(child, sink);
    }

    private List<(int? Count, string W)>? BuildDefenderWounds(Selection? unit)
    {
        if (unit == null) return null;
        var models = new List<(int Number, Profile Profile)>();
        CollectUnitModels(unit, models);

        var order = new List<string>();
        var totals = new Dictionary<string, int>();
        foreach (var (n, p) in models)
        {
            var w = RosterHelper.GetChar(p, "W");
            if (string.IsNullOrEmpty(w) || w == "-") continue;
            if (!totals.ContainsKey(w)) order.Add(w);
            totals[w] = totals.GetValueOrDefault(w) + n;
        }

        if (order.Count == 0) return null;
        if (order.Count == 1) return new() { (null, order[0]) };
        return order.Select(w => ((int?)totals[w], w)).ToList();
    }

    private string GetChar(Profile? p, string statName) => RosterHelper.GetChar(p, statName);

    private void ShowStratagem(StratagemModelWithDetachment strat) => SelectedStratagem = strat;
    private void CloseModal() => SelectedStratagem = null;

    private void ShowUnitDetails(UnitEntry entry) => ModalUnit = entry;
    private void CloseUnitDetails() => ModalUnit = null;

    private void ShowRule(Rule rule) => SelectedRule = rule;
    private void CloseRuleModal() => SelectedRule = null;

    private List<Rule> GetAbilities(Selection unit) => RosterHelper.GetAbilities(unit, filterWeaponKeywords: true);

    private List<string> GetKeywords(Selection unit) => RosterHelper.GetKeywords(unit);

    private static MarkupString FormatText(string text) => RosterHelper.FormatText(text);

    private static string StratClass(StratagemModelWithDetachment s)
    {
        var t = s.Turn.ToLower();
        if (t.Contains("your")) return "strat-blue";
        if (t.Contains("opponent")) return "strat-red";
        return "strat-green";
    }
}

