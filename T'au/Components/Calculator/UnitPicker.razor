@using Warhammer.Models
@using Warhammer.Models.Calculator

@* Group filter + the units grouped by army (players, then GM, then plain rosters), one row each with T/Sv and the seat stripe. *@
<div class="ds-units">
    <div class="ds-filter" role="group" aria-label="Filter by army">
        <button type="button" class="ds-filter-btn @(PlayerFilter is null ? "ds-filter-on" : "")"
                @onclick="() => FilterChanged.InvokeAsync(null)">All</button>
        @foreach (var (g, seat) in Groups)
        {
            var id = g.Id;
            <button type="button" class="ds-filter-btn @(PlayerFilter == id ? "ds-filter-on" : "")" data-filter="@id"
                    style="--ds-accent:@PlayerTheme.GetColor(seat)" @onclick="() => FilterChanged.InvokeAsync(id)">
                @g.Name
            </button>
        }
    </div>
    @foreach (var (g, seat) in Groups.Where(x => PlayerFilter is null || x.Group.Id == PlayerFilter))
    {
        var color = PlayerTheme.GetColor(seat);
        <div class="ds-ugroup">
            <div class="ds-uplayer" style="color:@color">
                @g.Name
                @if (g.Tag is not null)
                {
                    <span class="ds-utag">@g.Tag</span>
                }
            </div>
            @foreach (var u in Units.Where(x => x.Group.Id == g.Id))
            {
                var unit = u;
                var profile = RosterHelper.GetAllProfilesRecursive(u.Unit, "Unit").FirstOrDefault();
                <button type="button" class="ds-unit @(Selected?.Key == u.Key ? "ds-unit-on" : "")" data-unit="@u.Key"
                        style="--ds-accent:@color" @onclick="() => Picked.InvokeAsync(unit)">
                    <span>
                        @u.Label
                        @if (u.CrusadeData is not null)
                        {
                            <i class="bi bi-shield-shaded ds-crusade-mark" title="Crusade Card"></i>
                        }
                    </span>
                    <span class="ds-unit-t">T@(RosterHelper.GetChar(profile, "T")) Sv@(RosterHelper.GetChar(profile, "SV"))</span>
                </button>
            }
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<UnitEntry> Units { get; set; } = [];
    [Parameter] public string? PlayerFilter { get; set; }
    [Parameter] public UnitEntry? Selected { get; set; }
    [Parameter] public EventCallback<string?> FilterChanged { get; set; }
    [Parameter] public EventCallback<UnitEntry> Picked { get; set; }

    // Each group with the roster seat that colours it.
    private IEnumerable<(UnitGroup Group, string Seat)> Groups =>
        Units.Select(u => (u.Group, u.PlayerId)).DistinctBy(x => x.Group.Id).OrderBy(x => x.Group.Order);
}
